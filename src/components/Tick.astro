---
/** Small check mark used in the "what's included" lists. Decorative. */
interface Props {
  class?: string;
}

const { class: className = 'mt-1 size-4 shrink-0 text-accent' } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d="m4 10.5 4 4 8-9"></path>
</svg>
