---
import { Image, getImage } from 'astro:assets';

import about from '~/assets/nav/about.webp';
import contact from '~/assets/nav/contact.webp';
import faq from '~/assets/nav/faq.webp';
import managementPlans from '~/assets/nav/management-plans.webp';
import services from '~/assets/nav/services.webp';
import tools from '~/assets/nav/tools.webp';
import whyUs from '~/assets/nav/why-us.webp';

import aboutDark from '~/assets/nav/about-dark.webp';
import contactDark from '~/assets/nav/contact-dark.webp';
import faqDark from '~/assets/nav/faq-dark.webp';
import managementPlansDark from '~/assets/nav/management-plans-dark.webp';
import servicesDark from '~/assets/nav/services-dark.webp';
import toolsDark from '~/assets/nav/tools-dark.webp';
import whyUsDark from '~/assets/nav/why-us-dark.webp';

/**
 * The navigation icons Antonio drew, keyed by the `icon` field on NAV.
 *
 * The imports are written out rather than globbed so that a nav item naming
 * an icon that does not exist fails the type check instead of rendering a
 * gap. `src/assets/nav/` is generated by scripts/prepare-nav-icons.mjs.
 *
 * The artwork is navy with gold accents, which disappears against the dark
 * header, so the generator also produces a light-on-dark twin of each icon.
 * A <source media> picks between them: the site themes purely off
 * prefers-color-scheme with no manual toggle, so the media query is the whole
 * story, and the browser fetches only the set that matches.
 *
 * Every icon is decorative: the nav item's own text is right beside it, so
 * announcing the picture as well would make a screen reader say each
 * destination twice.
 */
const ICONS = {
  about,
  contact,
  faq,
  'management-plans': managementPlans,
  services,
  tools,
  'why-us': whyUs,
} as const;

const DARK_ICONS = {
  about: aboutDark,
  contact: contactDark,
  faq: faqDark,
  'management-plans': managementPlansDark,
  services: servicesDark,
  tools: toolsDark,
  'why-us': whyUsDark,
} as const;

/**
 * One fixed set of widths for every use, rather than widths derived from the
 * painted size. The header paints these at 28px and the mobile menu at 32px;
 * deriving the widths would give those two the same picture under different
 * URLs, so each icon would be fetched twice. These cover 1x, 2x and 3x of
 * both.
 */
const WIDTHS = [32, 64, 96];

interface Props {
  icon: keyof typeof ICONS;
  /** CSS pixel size the icon is painted at, for the `sizes` hint. */
  size?: number;
  class?: string;
}

const { icon, size = 28, class: className = '' } = Astro.props;

const dark = await getImage({
  src: DARK_ICONS[icon],
  widths: WIDTHS,
  format: 'webp',
});
---

{/*
  display:contents so the <picture> box does not sit between the flex
  container and the image it lays out.
*/}
<picture class="contents">
  <source
    media="(prefers-color-scheme: dark)"
    srcset={dark.srcSet.attribute}
    sizes={`${size}px`}
    type="image/webp"
  />
  <Image
    src={ICONS[icon]}
    alt=""
    widths={WIDTHS}
    sizes={`${size}px`}
    loading="eager"
    class={className}
  />
</picture>
