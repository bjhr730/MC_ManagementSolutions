---
import about from '~/assets/nav/about.webp';
import contact from '~/assets/nav/contact.webp';
import faq from '~/assets/nav/faq.webp';
import managementPlans from '~/assets/nav/management-plans.webp';
import services from '~/assets/nav/services.webp';
import tools from '~/assets/nav/tools.webp';
import whyUs from '~/assets/nav/why-us.webp';

import aboutDark from '~/assets/nav/about-dark.webp';
import contactDark from '~/assets/nav/contact-dark.webp';
import faqDark from '~/assets/nav/faq-dark.webp';
import managementPlansDark from '~/assets/nav/management-plans-dark.webp';
import servicesDark from '~/assets/nav/services-dark.webp';
import toolsDark from '~/assets/nav/tools-dark.webp';
import whyUsDark from '~/assets/nav/why-us-dark.webp';

/**
 * The navigation icons Antonio drew, keyed by the `icon` field on NAV.
 *
 * These are plain <img> tags pointing at the imported asset's own URL, NOT
 * astro:assets <Image>. That is deliberate and it is a bug fix.
 *
 * astro:assets only pre-generates resized variants for prerendered pages.
 * /contact is `prerender = false` because it handles the form POST, so there
 * <Image> emitted `/_image?href=...` for the on-demand endpoint — which a
 * static build with the Vercel adapter never deploys. It 404'd, and every
 * image on the contact page rendered as a broken placeholder: all seven
 * icons twice over, plus all three logo lockups.
 *
 * Referencing the built file directly produces the same `/_astro/...webp`
 * URL on every route, prerendered or not. The cost is no responsive
 * variants — fine here, because the source is 128px and these are painted
 * at 28px (header) and 32px (menu), so one file already covers up to 4x.
 *
 * The dark twin still swaps on prefers-color-scheme, now via a <source>
 * whose srcset is the asset URL rather than a generated one.
 *
 * Every icon is decorative: the nav item's own text is right beside it, so
 * announcing the picture as well would make a screen reader say each
 * destination twice.
 */
const ICONS = {
  about,
  contact,
  faq,
  'management-plans': managementPlans,
  services,
  tools,
  'why-us': whyUs,
} as const;

const DARK_ICONS = {
  about: aboutDark,
  contact: contactDark,
  faq: faqDark,
  'management-plans': managementPlansDark,
  services: servicesDark,
  tools: toolsDark,
  'why-us': whyUsDark,
} as const;

interface Props {
  icon: keyof typeof ICONS;
  /** CSS pixel size the icon is painted at. */
  size?: number;
  class?: string;
}

const { icon, size = 28, class: className = '' } = Astro.props;

const light = ICONS[icon];
const dark = DARK_ICONS[icon];
---

{/*
  display:contents so the <picture> box does not sit between the flex
  container and the image it lays out.
*/}
<picture class="contents">
  <source media="(prefers-color-scheme: dark)" srcset={dark.src} type="image/webp" />
  <img
    src={light.src}
    alt=""
    width={size}
    height={size}
    loading="eager"
    decoding="async"
    class={className}
  />
</picture>
