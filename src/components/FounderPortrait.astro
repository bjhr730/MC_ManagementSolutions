---
import { Image } from 'astro:assets';
import portrait from '~/assets/antonio-melendez.webp';
import { FOUNDER_NAME } from '~/content/founder';
import { LEGAL_ENTITY } from '~/config/site';

/**
 * Antonio's portrait, in one place so the home page and the founder page
 * cannot drift apart on alt text, sizing or art direction.
 *
 * The asset is 900x1200 — exactly 3:4 — so the frame uses that ratio rather
 * than the 4:5 the original placeholder had. Cropping to 4:5 would take
 * height off a portrait that is already framed tightly.
 *
 * The two pages paint it at different sizes: 352px on the founder page and
 * 384px in the home page teaser. `sizes` declares the larger of the two and
 * 384 is in `widths`, because declaring the smaller had the browser fetch a
 * 352px file for the 384px frame and upscale it.
 *
 * astro:assets emits AVIF and WebP at the widths below and sets intrinsic
 * width/height, so the space is reserved before the image arrives and the
 * layout does not shift.
 */
interface Props {
  /** Eager above the fold (the founder page), lazy below it (the home page). */
  priority?: boolean;
  /**
   * The small badge over the portrait, as in the reference. Off by default:
   * on the home page the teaser beside it already says Antonio owns rental
   * property, and the badge would be the same claim twice in one block.
   */
  badge?: boolean;
  class?: string;
}

const { priority = false, badge = false, class: className = '' } = Astro.props;
---

<figure class={`relative m-0 ${className}`}>
  <Image
    src={portrait}
    alt={`${FOUNDER_NAME}, founder of ${LEGAL_ENTITY}`}
    widths={[384, 448, 704, 896]}
    sizes="(min-width: 1024px) 24rem, (min-width: 640px) 24rem, calc(100vw - 2rem)"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="aspect-3/4 w-full rounded-lg border border-line object-cover"
  />

  {/*
    Decorative: it restates, in three words, a fact the surrounding prose
    already makes. A screen reader meeting it between the portrait and the
    text would hear the same claim a third time.
  */}
  {
    badge && (
      <figcaption
        aria-hidden="true"
        class="absolute bottom-4 left-4 right-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-[#081426]/88 px-4 py-2 text-xs font-semibold text-white backdrop-blur-sm sm:right-auto"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 shrink-0 text-gold-bright"
        >
          <path d="M3 9.5 10 4l7 5.5V16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z" />
        </svg>
        A rental property owner himself
      </figcaption>
    )
  }
</figure>
