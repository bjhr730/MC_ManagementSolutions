---
import { Image } from 'astro:assets';
import portrait from '~/assets/antonio-melendez.webp';
import { FOUNDER_NAME } from '~/content/founder';
import { LEGAL_ENTITY } from '~/config/site';

/**
 * Antonio's portrait, in one place so the home page and the founder page
 * cannot drift apart on alt text, sizing or art direction.
 *
 * The asset is 900x1200 — exactly 3:4 — so the frame uses that ratio rather
 * than the 4:5 the original placeholder had. Cropping to 4:5 would take
 * height off a portrait that is already framed tightly.
 *
 * The two pages paint it at different sizes: 352px on the founder page and
 * 384px in the home page teaser. `sizes` declares the larger of the two and
 * 384 is in `widths`, because declaring the smaller had the browser fetch a
 * 352px file for the 384px frame and upscale it.
 *
 * astro:assets emits AVIF and WebP at the widths below and sets intrinsic
 * width/height, so the space is reserved before the image arrives and the
 * layout does not shift.
 */
interface Props {
  /** Eager above the fold (the founder page), lazy below it (the home page). */
  priority?: boolean;
  class?: string;
}

const { priority = false, class: className = '' } = Astro.props;
---

<figure class={`m-0 ${className}`}>
  <Image
    src={portrait}
    alt={`${FOUNDER_NAME}, founder of ${LEGAL_ENTITY}`}
    widths={[384, 448, 704, 896]}
    sizes="(min-width: 1024px) 24rem, (min-width: 640px) 24rem, calc(100vw - 2rem)"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="aspect-3/4 w-full rounded-lg border border-line object-cover"
  />
</figure>
