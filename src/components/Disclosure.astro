---
/**
 * A compliance note: visually quiet so it does not compete with the copy,
 * but never hidden, because these are the notes that have to be read.
 *
 * A plain <div>, not an <aside>. An <aside> is a complementary landmark, and
 * these sit inside <main> within the flow of the page — which axe flags as
 * landmark-complementary-is-top-level, on ten routes here. The note is not a
 * region of the page a reader would want to jump to or skip past; it belongs
 * to the paragraph it follows.
 */
interface Props {
  label?: string;
  /** Marks text still awaiting legal review. */
  pending?: boolean;
}

const { label = 'Disclosure', pending = false } = Astro.props;
---

<div
  class={`rounded-md border-l-4 px-4 py-3 text-sm leading-relaxed ${
    pending
      ? 'border-gold bg-surface-3 text-ink'
      : 'border-line-strong bg-surface-2 text-ink-muted'
  }`}
>
  <p class="font-sans text-xs font-semibold uppercase tracking-[0.08em] text-ink-muted">
    {pending ? `${label} \u2014 pending review` : label}
  </p>
  <div class="mt-1.5"><slot /></div>
</div>
