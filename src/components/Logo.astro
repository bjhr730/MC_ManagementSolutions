---
import { Image } from 'astro:assets';
import mark from '~/assets/mc-logo-mark.webp';

/**
 * The logo lockup: Antonio's badge, then the name set in type.
 *
 * The badge he supplied has an opaque dark-navy background, so it cannot sit
 * directly on a light surface. Rounding it and treating it as a badge makes
 * that deliberate rather than accidental. When a version with a transparent
 * background arrives, the mark can sit bare and the rounding can go.
 *
 * The badge is decorative: the company name is right beside it as real text,
 * which keeps it crisp at any size, selectable, and readable by assistive
 * technology without relying on alt text.
 */
interface Props {
  /** Larger treatment for the footer. */
  size?: 'sm' | 'md';
  /** Light text, for use on the dark footer and CTA bands. */
  onDark?: boolean;
}

const { size = 'sm', onDark = false } = Astro.props;

const badge = size === 'sm' ? 'size-9' : 'size-11';
const name = size === 'sm' ? 'text-[1.0625rem]' : 'text-xl';
---

<span class="inline-flex items-center gap-2.5">
  <Image
    src={mark}
    alt=""
    widths={[72, 144]}
    sizes="44px"
    loading="eager"
    class={`${badge} shrink-0 rounded-md`}
  />
  <span class="inline-flex items-baseline gap-2">
    <span
      class={`font-serif font-semibold tracking-tight ${name} ${onDark ? 'text-white' : 'text-ink'}`}
      >MC</span
    >
    <span
      aria-hidden="true"
      class={`h-4 w-px self-center ${onDark ? 'bg-white/40' : 'bg-line-strong'}`}
    ></span>
    <span
      class={`font-sans text-[0.625rem] font-semibold uppercase leading-tight tracking-[0.14em] ${onDark ? 'text-silver-300' : 'text-ink-muted'}`}
      >Management <br />Solutions</span
    >
  </span>
</span>
