---
import { Image } from 'astro:assets';
import mark from '~/assets/mc-logo-mark.webp';

/**
 * The logo lockup: Antonio's badge, then "Management Solutions" in type.
 *
 * The badge he supplied has an opaque dark-navy background, so it cannot sit
 * directly on a light surface. Rounding it and treating it as a badge makes
 * that deliberate rather than accidental. When a version with a transparent
 * background arrives, the mark can sit bare and the rounding can go.
 *
 * The visible "MC" came out in November 2026 — Antonio found it redundant
 * next to a badge that already has the letters in it. They stay in the
 * accessible text as a visually hidden span, because they are part of the
 * company's name and are only *visually* redundant: without them the footer
 * and the mobile menu, where the lockup is not wrapped in a labelled link,
 * would announce the company as "Management Solutions".
 *
 * The badge itself stays decorative. Giving it alt="MC" instead would be
 * ignored in the header, where the link's own aria-label wins, and would
 * read as a stray letter wherever it was not.
 *
 * Sizing: the badge and the wordmark scale together, so the lockup keeps its
 * proportions. The header bar is h-16 on mobile and md:h-20 from the medium
 * breakpoint, so the badge steps up at the same breakpoint.
 */
interface Props {
  /** Larger treatment for the footer. */
  size?: 'sm' | 'md';
  /** Light text, for use on the dark footer and CTA bands. */
  onDark?: boolean;
}

const { size = 'sm', onDark = false } = Astro.props;

const isSm = size === 'sm';

// Badge: 44px → 56px in the header, 56px → 64px in the footer.
const badge = isSm ? 'size-11 md:size-14' : 'size-14 sm:size-16';

// The largest the badge is ever painted, used to pick the srcset widths so
// the browser has a 2x source and nothing larger.
const renderedPx = isSm ? 56 : 64;

// A step up from the old sizes: with "MC" gone this is the only text in the
// lockup, so it carries the weight the pairing used to share.
const nameType = isSm
  ? 'text-[0.8125rem] md:text-[0.9375rem]'
  : 'text-[0.9375rem] sm:text-[1.0625rem]';
const gap = isSm ? 'gap-3 md:gap-3.5' : 'gap-3.5 sm:gap-4';
---

<span class={`inline-flex items-center ${gap}`}>
  <Image
    src={mark}
    alt=""
    widths={[renderedPx, renderedPx * 2]}
    sizes={`${renderedPx}px`}
    loading="eager"
    class={`${badge} shrink-0 rounded-lg`}
  />
  <span
    class={`font-sans ${nameType} font-semibold uppercase leading-tight tracking-[0.12em] ${onDark ? 'text-silver-200' : 'text-ink'}`}
  >
    <span class="sr-only">MC </span>Management <br />Solutions
  </span>
</span>
