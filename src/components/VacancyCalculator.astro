---
import { computeVacancy, days, EXAMPLE, LIMITS, money, share } from '~/lib/vacancy';

/**
 * Tool 1: what an empty property costs.
 *
 * The example result is computed at build time, so the tool shows a worked
 * answer before any JavaScript runs. The browser script recomputes the same
 * numbers from the same module as the inputs move.
 */
const r = computeVacancy(EXAMPLE);

const segW = {
  lostRent: share(r.lostRent, r.totalExposure),
  carryingCost: share(r.carryingCost, r.totalExposure),
  turnoverCost: share(r.turnoverCost, r.totalExposure),
};
const segX = {
  lostRent: 0,
  carryingCost: segW.lostRent,
  turnoverCost: segW.lostRent + segW.carryingCost,
};

const amounts = [
  {
    id: 'rent',
    label: 'Monthly asking rent',
    value: EXAMPLE.rent,
    hint: 'What you plan to ask per month.',
  },
  {
    id: 'carrying',
    label: 'Monthly carrying costs',
    value: EXAMPLE.carrying,
    hint: 'Mortgage, HOA fees, insurance and utilities. These continue whether or not the property is occupied.',
  },
  {
    id: 'turnover',
    label: 'One-time turnover expenses',
    value: EXAMPLE.turnover,
    hint: 'Cleaning, repairs, make-ready and leasing charges between tenants.',
  },
] as const;
---

<div class="rounded-xl border border-line bg-surface p-6 md:p-8" id="vacancy-calculator">
  <form id="vacancy-form" novalidate onsubmit="return false">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-12">
      <div>
        <fieldset>
          <legend class="font-serif text-h3 font-semibold text-ink">
            Your property
          </legend>
          <p class="mt-2 text-sm text-ink-muted">
            These are example figures. Change them to yours &mdash; nothing is
            sent anywhere.
          </p>

          <div class="mt-6 space-y-5">
            {
              amounts.map((field) => (
                <div>
                  <label for={`v-${field.id}`} class="field-label">
                    {field.label}
                  </label>
                  <div class="relative">
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"
                    >
                      $
                    </span>
                    <input
                      id={`v-${field.id}`}
                      name={field.id}
                      type="number"
                      inputmode="numeric"
                      min="0"
                      step="25"
                      value={field.value}
                      aria-describedby={`v-${field.id}-hint`}
                      class="field-input tabular-nums pl-7"
                    />
                  </div>
                  <span id={`v-${field.id}-hint`} class="mt-1.5 block text-sm text-ink-muted">
                    {field.hint}
                  </span>
                </div>
              ))
            }

            <div>
              <div class="flex items-baseline justify-between gap-3">
                <label for="v-vacancyDays" class="field-label mb-0">
                  Expected vacancy
                </label>
                <output
                  for="v-vacancyDays"
                  data-out="vacancyDaysLabel"
                  class="font-serif text-lg font-semibold tabular-nums text-ink"
                >
                  {days(EXAMPLE.vacancyDays)}
                </output>
              </div>
              <input
                id="v-vacancyDays"
                name="vacancyDays"
                type="range"
                min={LIMITS.vacancyDays.min}
                max={LIMITS.vacancyDays.max}
                step={LIMITS.vacancyDays.step}
                value={EXAMPLE.vacancyDays}
                aria-describedby="v-vacancyDays-hint"
                class="range-input mt-3"
              />
              <span id="v-vacancyDays-hint" class="mt-1.5 block text-sm text-ink-muted">
                How long you expect it to sit empty between tenants.
              </span>
            </div>
          </div>
        </fieldset>

        <button type="reset" class="btn btn-secondary mt-7">
          Reset calculator
        </button>
      </div>

      <output for="vacancy-form" aria-live="polite" class="block">
        <section class="rounded-lg bg-surface-2 p-6 md:p-7" aria-labelledby="calc-a">
          <h3 id="calc-a" class="font-serif text-h3 font-semibold text-ink">
            What the vacancy exposes you to
          </h3>

          <dl class="mt-6 space-y-3">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-muted">Lost rental income</dt>
              <dd class="font-medium tabular-nums text-ink" data-out="lostRent">
                {money(r.lostRent)}
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-muted">Carrying costs while empty</dt>
              <dd class="font-medium tabular-nums text-ink" data-out="carryingCost">
                {money(r.carryingCost)}
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-muted">One-time turnover expenses</dt>
              <dd class="font-medium tabular-nums text-ink" data-out="turnoverCost">
                {money(r.turnoverCost)}
              </dd>
            </div>
          </dl>

          {/*
            Proportions of the total. Decorative: every figure it encodes is
            in the list above. Drawn as SVG because `width` is a presentation
            attribute, which the CSP does not govern, unlike inline styles.
          */}
          <svg
            aria-hidden="true"
            viewBox="0 0 100 1"
            preserveAspectRatio="none"
            class="mt-6 block h-3 w-full overflow-hidden rounded-full bg-surface-3"
          >
            <rect data-bar="lostRent" x={segX.lostRent} y="0" height="1" width={segW.lostRent} class="fill-cost"></rect>
            <rect data-bar="carryingCost" x={segX.carryingCost} y="0" height="1" width={segW.carryingCost} class="fill-navy-500"></rect>
            <rect data-bar="turnoverCost" x={segX.turnoverCost} y="0" height="1" width={segW.turnoverCost} class="fill-evergreen-500"></rect>
          </svg>

          <div class="mt-6 border-t-2 border-accent pt-5">
            <p class="text-sm font-semibold uppercase tracking-[0.08em] text-ink-muted">
              Total cash-flow exposure
            </p>
            <p
              class="mt-1 font-serif text-display font-semibold tabular-nums text-cost"
              data-out="totalExposure"
            >
              {money(r.totalExposure)}
            </p>
          </div>

          <p class="mt-5 text-sm leading-relaxed text-ink-muted">
            Of that, <strong class="font-semibold text-ink" data-out="vacancyCaused"
              >{money(r.vacancyCaused)}</strong
            > exists only because the property is empty. The carrying costs would
            fall due anyway &mdash; while it is vacant there is simply no rent
            coming in to meet them. Every further day empty adds
            <strong class="font-semibold text-ink" data-out="costPerDay"
              >{money(r.costPerDay)}</strong
            >.
          </p>
        </section>
      </output>
    </div>
  </form>

  <noscript>
    <p class="mt-6 rounded-md bg-surface-3 px-4 py-3 text-sm text-ink">
      The figures above are a worked example. The calculator updates as you
      change the inputs, which needs JavaScript &mdash; or
      <a href="/contact" class="underline underline-offset-2">send us the property details</a>
      and we will run the numbers with you.
    </p>
  </noscript>
</div>

<script>
  import { computeVacancy, days, money, share, type VacancyInput } from '~/lib/vacancy';

  const form = document.getElementById('vacancy-form') as HTMLFormElement | null;

  if (form) {
    const root = document.getElementById('vacancy-calculator');
    const out = (key: string) =>
      root?.querySelector<HTMLElement>(`[data-out="${key}"]`);
    const bar = (key: string) =>
      root?.querySelector<HTMLElement>(`[data-bar="${key}"]`);

    const num = (name: string) =>
      Number((form.elements.namedItem(name) as HTMLInputElement | null)?.value);

    const read = (): VacancyInput => ({
      rent: num('rent'),
      vacancyDays: num('vacancyDays'),
      carrying: num('carrying'),
      turnover: num('turnover'),
    });

    const set = (key: string, value: string) => {
      const el = out(key);
      if (el) el.textContent = value;
    };

    let latest = read();

    const render = () => {
      const input = read();
      latest = input;
      const result = computeVacancy(input);

      set('vacancyDaysLabel', days(input.vacancyDays));
      set('lostRent', money(result.lostRent));
      set('carryingCost', money(result.carryingCost));
      set('turnoverCost', money(result.turnoverCost));
      set('totalExposure', money(result.totalExposure));
      set('vacancyCaused', money(result.vacancyCaused));
      set('costPerDay', money(result.costPerDay));

      // Presentation attributes, not styles: nothing here trips the CSP.
      let offset = 0;
      for (const key of ['lostRent', 'carryingCost', 'turnoverCost'] as const) {
        const width = share(result[key], result.totalExposure);
        const el = bar(key);
        if (el) {
          el.setAttribute('x', String(offset));
          el.setAttribute('width', String(width));
        }
        offset += width;
      }
    };

    form.addEventListener('input', render);
    form.addEventListener('reset', () => window.setTimeout(render, 0));

    /**
     * Carry the figures to the contact form, but only when the visitor asks
     * for a rental evaluation. sessionStorage rather than the URL: these are
     * someone's property finances and do not belong in a shareable link or a
     * server log.
     */
    document.getElementById('send-vacancy-figures')?.addEventListener('click', () => {
      const result = computeVacancy(latest);
      const summary = [
        'My figures from the vacancy cost calculator:',
        '',
        `Monthly asking rent: ${money(latest.rent)}`,
        `Expected vacancy: ${days(latest.vacancyDays)}`,
        `Monthly carrying costs: ${money(latest.carrying)}`,
        `One-time turnover expenses: ${money(latest.turnover)}`,
        '',
        `Lost rental income: ${money(result.lostRent)}`,
        `Carrying costs while empty: ${money(result.carryingCost)}`,
        `Total cash-flow exposure: ${money(result.totalExposure)}`,
        '',
        'I would like a personalized rental evaluation.',
      ].join('\n');

      try {
        sessionStorage.setItem('ma:tool-summary', summary);
      } catch {
        // Private browsing or blocked storage: the link still works, the
        // figures just do not travel with it.
      }
    });

    render();
  }
</script>
