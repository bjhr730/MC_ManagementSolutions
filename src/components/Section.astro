---
/** Vertical rhythm wrapper. `tone` paints the band behind the content. */
interface Props {
  tone?: 'default' | 'muted' | 'band' | 'deep' | 'inverse';
  /** Tightens the vertical padding for dense bands. */
  compact?: boolean;
  labelledby?: string;
  class?: string;
}

const {
  tone = 'default',
  compact = false,
  labelledby,
  class: className = '',
} = Astro.props;

const tones = {
  default: 'bg-surface',
  muted: 'bg-surface-2',
  band: 'bg-surface-band',
  deep: 'bg-band-deep text-band-deep-soft',
  inverse: 'bg-navy-800 text-silver-200',
};

const pad = compact ? 'section-y-compact' : 'section-y';
---

<section class={`${tones[tone]} ${pad}`} aria-labelledby={labelledby}>
  <div class={`container-page ${className}`}>
    <slot />
  </div>
</section>
