---
/** Vertical rhythm wrapper. `tone` paints the band behind the content. */
interface Props {
  tone?: 'default' | 'muted' | 'band' | 'deep' | 'inverse';
  /** Tightens the vertical padding for dense bands. */
  compact?: boolean;
  labelledby?: string;
  class?: string;
}

const {
  tone = 'default',
  compact = false,
  labelledby,
  class: className = '',
} = Astro.props;

/*
  default is the page silver, NOT --color-surface. Cards are --color-surface,
  so when default painted that too, a card on a default section was invisible
  and the whole page read as one flat field. With default on the page colour
  every card lifts off it, and the ladder below actually steps.
*/
const tones = {
  default: 'bg-page',
  muted: 'bg-surface-2',
  band: 'bg-surface-band',
  deep: 'bg-band-deep text-band-deep-soft',
  inverse: 'bg-navy-800 text-silver-200',
};

const pad = compact ? 'section-y-compact' : 'section-y';
---

<section class={`${tones[tone]} ${pad}`} aria-labelledby={labelledby}>
  <div class={`container-page ${className}`}>
    <slot />
  </div>
</section>
