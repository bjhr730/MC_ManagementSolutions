---
import Logo from './Logo.astro';
import NavIcon from './NavIcon.astro';
import { CONTACT, NAV, PORTAL_LINKS, PORTALS_LIVE } from '~/config/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur-sm relative">
  {/*
    Portal utility bar. Until Buildium is live these point at /portals, which
    says so and gives people the direct route instead; the master checklist
    forbids advertising a portal that does not exist yet.
  */}
  <div class="border-b border-line bg-navy-800 text-silver-200">
    <nav aria-label="Portals" class="container-page flex h-9 items-center justify-end gap-5">
      {
        PORTAL_LINKS.map((portal) => (
          <a
            href={portal.href}
            class="inline-flex items-center text-xs font-medium tracking-wide text-silver-200 underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white"
          >
            {portal.label}
            {!PORTALS_LIVE && (
              <span class="ml-1.5 text-[0.625rem] uppercase tracking-wider text-silver-400">
                soon
              </span>
            )}
          </a>
        ))
      }
    </nav>
  </div>

  {/* How far down the page you are. Driven by scroll(), no JavaScript. */}
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 bg-transparent">
    <div class="scroll-progress h-full w-full bg-gold"></div>
  </div>

  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex items-center" aria-label="MC Management Solutions, home">
      <Logo />
    </a>

    {/* Desktop navigation */}
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-start gap-0.5">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-item group flex min-h-11 w-[5.625rem] flex-col items-center gap-1 rounded px-0.5 py-1.5 hover:bg-surface-3"
              >
                <NavIcon icon={item.icon} size={28} class="nav-item-icon size-7" />
                <span class="text-balance text-center text-[0.8125rem] font-medium leading-tight text-ink-muted group-hover:text-ink group-aria-[current=page]:text-ink group-aria-[current=page]:underline group-aria-[current=page]:decoration-gold group-aria-[current=page]:decoration-2 group-aria-[current=page]:underline-offset-4">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={CONTACT.phoneHref}
        class="hidden min-h-11 items-center whitespace-nowrap rounded px-3 text-sm font-medium text-ink-muted hover:text-ink xl:inline-flex"
      >
        {CONTACT.phone}
      </a>

      {/*
        The call to action in the header itself, as in the reference. It is
        the one thing every page is trying to get to, and until now it was
        only reachable by finding it in the body or opening the nav.

        From xl, not lg. At 1024 the row cannot hold the logo, seven nav
        items and a 195px button: with the button present no nav minimum
        fits, not even 64px. It had been hiding that by wrapping onto two
        lines, which read as a squashed button rather than as "too narrow".
        whitespace-nowrap stops it wrapping again — if it ever does not fit,
        that now shows up as an overflow a test can catch. The phone number
        beside it gets the same treatment: with the button held to one line
        the pressure simply moved next door and the number broke across
        three lines instead.

        At 1280 the container caps at 1200px and splits 199 logo / 650 nav
        / 335 for the number and button, leaving about 90px per item for
        seven items. That is what sets w-[5.625rem]: every item is exactly
        90px, so the icons sit on a real grid instead of drifting with the
        length of each word. The two labels too long for 90px on one line
        — "Management Plans" at 139px and "Why Choose Us" at 119px — wrap
        to two lines, and text-balance splits them "Management / Plans"
        and "Why / Choose Us" rather than orphaning a word. Measured at
        1280: all seven 90px, no page overflow, button and number each
        still on one line.

        Equal width is only reachable *because* the labels may wrap.
        Putting whitespace-nowrap back on the row forces 139px minimums
        and 973px of nav, which will not sit beside a 199px logo, the
        number and a 195px button.
      */}
      <a
        href="/contact"
        class="btn btn-gold hidden whitespace-nowrap !min-h-10 !px-5 !text-sm xl:inline-flex"
      >
        Request a consultation
      </a>

      {/* Mobile menu trigger */}
      <button
        type="button"
        id="nav-open"
        aria-expanded="false"
        aria-controls="nav-dialog"
        class="inline-flex size-11 items-center justify-center rounded border border-line-strong text-ink lg:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  {/*
    Native <dialog> gives us the focus trap, Escape-to-close and background
    inerting for free, which is most of what a hand-rolled menu gets wrong.
  */}
  <dialog
    id="nav-dialog"
    aria-label="Site menu"
    class="m-0 max-h-none min-h-dvh w-full max-w-none bg-surface p-0 text-ink backdrop:bg-navy-950/60"
  >
    <div class="container-page flex h-16 items-center justify-between">
      <Logo />
      <button
        type="button"
        id="nav-close"
        class="inline-flex size-11 items-center justify-center rounded border border-line-strong text-ink"
      >
        <span class="sr-only">Close menu</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Site" class="container-page pb-10">
      <ul class="divide-y divide-line border-t border-line">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-item flex min-h-14 items-center gap-4 text-lg font-medium text-ink aria-[current=page]:text-accent"
              >
                <NavIcon icon={item.icon} size={32} class="nav-item-icon size-8 shrink-0" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href={CONTACT.phoneHref} class="btn btn-primary mt-6 w-full">
        Call {CONTACT.phone}
      </a>
    </nav>
  </dialog>

  <noscript>
    <nav aria-label="Primary" class="border-t border-line bg-surface-2 lg:hidden">
      <ul class="container-page flex flex-wrap gap-x-4 gap-y-1 py-3">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center text-sm font-medium text-ink underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </noscript>
</header>

<script>
  const dialog = document.getElementById('nav-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('nav-open');
  const closeBtn = document.getElementById('nav-close');

  if (dialog && openBtn && closeBtn) {
    const setExpanded = (value: boolean) =>
      openBtn.setAttribute('aria-expanded', String(value));

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      setExpanded(true);
    });

    closeBtn.addEventListener('click', () => dialog.close());

    // Fires for Escape as well as close(), so focus always returns correctly.
    dialog.addEventListener('close', () => {
      setExpanded(false);
      openBtn.focus();
    });

    // Tapping the backdrop closes the menu.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // A same-page link leaves the dialog open over the new scroll position.
    dialog.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a');
      if (link) dialog.close();
    });
  }
</script>
