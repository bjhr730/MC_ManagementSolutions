---
import Logo from './Logo.astro';
import NavIcon from './NavIcon.astro';
import { CONTACT, NAV, PORTAL_LINKS, PORTALS_LIVE } from '~/config/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur-sm relative">
  {/*
    Portal utility bar. Until Buildium is live these point at /portals, which
    says so and gives people the direct route instead; the master checklist
    forbids advertising a portal that does not exist yet.
  */}
  <div class="border-b border-line bg-navy-800 text-silver-200">
    <nav aria-label="Portals" class="container-page flex h-9 items-center justify-end gap-5">
      {
        PORTAL_LINKS.map((portal) => (
          <a
            href={portal.href}
            class="inline-flex h-full items-center text-xs font-medium tracking-wide text-silver-200 underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white"
          >
            {portal.label}
            {!PORTALS_LIVE && (
              <span class="ml-1.5 text-[0.625rem] uppercase tracking-wider text-silver-400">
                soon
              </span>
            )}
          </a>
        ))
      }
    </nav>
  </div>

  {/* How far down the page you are. Driven by scroll(), no JavaScript. */}
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 bg-transparent">
    <div class="scroll-progress h-full w-full bg-gold"></div>
  </div>

  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex items-center" aria-label="MC Management Solutions, home">
      <Logo />
    </a>

    {/* Desktop navigation */}
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-start gap-0.5">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-item group flex min-h-11 w-[5.625rem] flex-col items-center gap-1 rounded px-0.5 py-1.5 hover:bg-surface-3"
              >
                <NavIcon icon={item.icon} size={28} class="nav-item-icon size-7" />
                <span class="text-balance text-center text-[0.8125rem] font-medium leading-tight text-ink-muted group-hover:text-ink group-aria-[current=page]:text-ink group-aria-[current=page]:underline group-aria-[current=page]:decoration-gold group-aria-[current=page]:decoration-2 group-aria-[current=page]:underline-offset-4">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {/*
        The call to action in the header itself. It is the one thing every
        page is trying to get to.

        The phone number used to sit beside it and came out in November
        2026: Contact Us is in the nav and this button is right here, so the
        number was a third route to the same place competing with both. It
        is still on the contact page, in the footer, and as a full-width
        Call button inside the mobile menu, which is the one place a tap on
        a number is worth more than a tap on a form.

        From xl, not lg. At 1024 the row still cannot hold the logo, seven
        nav items and a 195px button - 199 + 195 + 32 of gaps leaves 558 for
        a nav that wants 642 - so removing the number did not buy enough to
        bring it down a breakpoint. whitespace-nowrap keeps it on one line,
        so if it ever does not fit that shows up as an overflow a test can
        catch rather than as a squashed two-line button.

        At 1280 the container caps at 1200 and splits 199 logo / 642 nav /
        195 button, which is what sets w-[5.625rem]: every item is exactly
        90px, so the icons sit on a real grid instead of drifting with the
        length of each word. Losing the number freed 132px, and it is
        deliberately left as slack: seven items at 119px would need 845 and
        there is 774, so no width reachable here puts "Why Choose Us" on one
        line, and widening would only add air. The two labels too long for
        90px — "Management Plans" at 139 and "Why Choose Us" at 119 —
        wrap to two lines, and text-balance splits them "Management /
        Plans" and "Why / Choose Us" rather than orphaning a word.

        Equal width is only reachable *because* the labels may wrap.
        Putting whitespace-nowrap back on the row forces 139px minimums and
        973px of nav, which will not sit beside the logo and the button.
      */}
      <a
        href="/contact"
        class="btn btn-gold hidden whitespace-nowrap !min-h-10 !px-5 !text-sm xl:inline-flex"
      >
        Request a consultation
      </a>

      {/* Mobile menu trigger */}
      <button
        type="button"
        id="nav-open"
        aria-expanded="false"
        aria-controls="nav-dialog"
        class="inline-flex size-11 items-center justify-center rounded border border-line-strong text-ink lg:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  {/*
    Native <dialog> gives us the focus trap, Escape-to-close and background
    inerting for free, which is most of what a hand-rolled menu gets wrong.
  */}
  <dialog
    id="nav-dialog"
    aria-label="Site menu"
    class="m-0 max-h-none min-h-dvh w-full max-w-none bg-surface p-0 text-ink backdrop:bg-navy-950/60"
  >
    <div class="container-page flex h-16 items-center justify-between">
      <Logo />
      <button
        type="button"
        id="nav-close"
        class="inline-flex size-11 items-center justify-center rounded border border-line-strong text-ink"
      >
        <span class="sr-only">Close menu</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Site" class="container-page pb-10">
      <ul class="divide-y divide-line border-t border-line">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-item flex min-h-14 items-center gap-4 text-lg font-medium text-ink aria-[current=page]:text-accent"
              >
                <NavIcon icon={item.icon} size={32} class="nav-item-icon size-8 shrink-0" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/*
        The menu used to end with the Call button alone, so the only action
        it offered was a phone call. The header's own CTA is xl-only, which
        means on a phone there was no route from the menu to the form at all.
        Gold first: it is the same primary action the header carries.
      */}
      <a href="/contact" class="btn btn-gold mt-6 w-full">
        Request a consultation
      </a>

      <a href={CONTACT.phoneHref} class="btn btn-primary mt-3 w-full">
        Call {CONTACT.phone}
      </a>
    </nav>
  </dialog>

  <noscript>
    <nav aria-label="Primary" class="border-t border-line bg-surface-2 lg:hidden">
      <ul class="container-page flex flex-wrap gap-x-4 gap-y-1 py-3">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center text-sm font-medium text-ink underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </noscript>
</header>

<script>
  const dialog = document.getElementById('nav-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('nav-open');
  const closeBtn = document.getElementById('nav-close');

  if (dialog && openBtn && closeBtn) {
    const setExpanded = (value: boolean) =>
      openBtn.setAttribute('aria-expanded', String(value));

    /*
      Releasing the scroll lock used to hang off the dialog's `close` event
      alone. Measured on production, that event did not arrive on the
      close-button path: the dialog closed, but aria-expanded stayed true,
      focus never came back, and - once the lock was added - <html> kept
      overflow:hidden, so the whole page was frozen with the menu shut.
      The stale aria-expanded was there before the lock and had gone
      unnoticed because Escape does fire `close` and looked fine.

      So the teardown no longer depends on an event arriving. Every path
      that closes the menu calls it directly, and the `close` listener stays
      as an idempotent backstop for the paths the browser owns (Escape, form
      method=dialog, close() called from anywhere else).
    */
    const release = () => {
      setExpanded(false);
      delete document.documentElement.dataset.navOpen;
    };

    const closeMenu = () => {
      dialog.close();
      release();
      openBtn.focus();
    };

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      setExpanded(true);
      // showModal() does not lock page scroll; see global.css.
      document.documentElement.dataset.navOpen = 'true';
    });

    closeBtn.addEventListener('click', closeMenu);

    dialog.addEventListener('close', () => {
      release();
      openBtn.focus();
    });

    // Tapping the backdrop closes the menu.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeMenu();
    });

    /*
      A link would otherwise leave the dialog open over the new scroll
      position. No focus call here: the page is navigating away.
    */
    dialog.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a');
      if (link) {
        dialog.close();
        release();
      }
    });
  }
</script>
