---
import type { FaqEntry } from '~/content/faq';

interface Props {
  entries: readonly FaqEntry[];
  /** Heading level for each question, so the page keeps a sane outline. */
  level?: 'h2' | 'h3' | 'h4';
}

const { entries, level = 'h3' } = Astro.props;
const Heading = level;
---

{/*
  Native <details>/<summary>: keyboard operable, announced correctly, and
  findable by in-page search once open. No JavaScript at all.
*/}
<ul class="space-y-3">
  {
    entries.map((entry) => (
      <li>
        <details class="faq-item group rounded-lg border border-line bg-surface">
          <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left">
            <Heading class="text-h3 font-serif font-semibold group-hover:text-accent">
              {entry.q}
            </Heading>
            <span class="faq-marker inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line-strong text-accent">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="size-4"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <div class="prose-site px-5 pb-5 text-ink-muted">
            {entry.a.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
      </li>
    ))
  }
</ul>
