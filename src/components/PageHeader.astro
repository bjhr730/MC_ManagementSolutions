---
import { Image } from 'astro:assets';

import conversation from '~/assets/photos/conversation.webp';
import homesStreet from '~/assets/photos/homes-street.webp';
import housesTrees from '~/assets/photos/houses-trees.webp';
import keys from '~/assets/photos/keys.webp';
import livingRoom from '~/assets/photos/living-room.webp';
import numbers from '~/assets/photos/numbers.webp';
import desk from '~/assets/photos/desk.webp';
import frontDoor from '~/assets/photos/front-door.webp';

/**
 * The band at the top of every inner page.
 *
 * `photo` adds a banner under the heading. It is a key into the map below
 * rather than an imported image passed in, so that a page cannot pick a
 * photo that does not exist, and so the alt text travels with the picture
 * instead of being retyped (and eventually mistyped) at each call site.
 *
 * Photos are decorative here: every one of them sits directly beneath a
 * heading and a lead paragraph that already say what the page is. Giving
 * them descriptive alt text would make a screen reader read the subject of
 * a stock photograph before the content it is decorating, which is noise.
 * They are marked alt="" deliberately, not by omission.
 */
const PHOTOS = {
  'homes-street': homesStreet,
  'living-room': livingRoom,
  conversation,
  desk,
  keys,
  numbers,
  'houses-trees': housesTrees,
  'front-door': frontDoor,
} as const;

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** An optional next step, directly under the lead. */
  cta?: { label: string; href: string };
  photo?: keyof typeof PHOTOS;
}

const { eyebrow, title, lead, cta, photo } = Astro.props;
---

{/*
  Two modes. Without a photo the band is a light surface, as it always was.
  With one, the photograph becomes the background of the band itself rather
  than a strip underneath it.

  That is Antonio's note and it is the right call on space. The strip was
  3:1 across a 1200px container, so roughly 400px plus its top margin, on
  every inner page, before the first sentence of content. As a background
  it costs nothing extra: the band has to be some height anyway.

  The scrim is .cta-scrim, reused rather than invented. It is already
  measured against photographs elsewhere on the site, and the light text
  pairings below are the ones proven on the closing call-to-action band.
*/}
<div
  class:list={[
    'border-b',
    photo ? 'relative isolate border-white/10' : 'border-line bg-surface-2',
  ]}
>
  {
    photo && (
      <>
        <Image
          src={PHOTOS[photo]}
          alt=""
          widths={[640, 960, 1400, 1800]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 size-full object-cover"
        />
        <div aria-hidden="true" class="page-scrim absolute inset-0 -z-10" />
      </>
    )
  }

  <div
    class:list={[
      'container-page',
      photo ? 'py-16 md:py-24' : 'py-12 md:py-16',
    ]}
  >
    {
      eyebrow && (
        <p class:list={['eyebrow', photo && '!text-gold-300']}>
          {eyebrow}
        </p>
      )
    }

    <h1
      class:list={[
        'mt-3 max-w-3xl text-h2 md:text-display',
        photo && 'text-white',
      ]}
    >
      {title}
    </h1>

    {
      lead && (
        <p
          class:list={[
            'mt-5 max-w-2xl text-lead',
            photo ? 'text-silver-200' : 'text-ink-muted',
          ]}
        >
          {lead}
        </p>
      )
    }

    {/*
      A link rather than a button. The page closes on the full call to
      action; a second button up here would compete with it, which is the
      thing we have just finished taking off the home page.
    */}
    {cta && (
      <p class="mt-6">
        <a
          href={cta.href}
          class:list={[
            'text-lead font-semibold underline decoration-2 underline-offset-4',
            photo
              ? 'text-white decoration-gold-300 hover:text-gold-300'
              : 'text-ink decoration-accent hover:text-accent',
          ]}
        >
          {cta.label}
        </a>
      </p>
    )}
  </div>
</div>
