---
import {
  compare,
  days,
  EXAMPLE_A,
  EXAMPLE_B,
  HORIZON_MONTHS,
  COMPARISON_PERIODS,
  money,
  SLIDER,
} from '~/lib/pricing';

/**
 * Tool 2: rent sooner at a lower price, or wait for a higher one.
 *
 * The fields start empty. EXAMPLE_A and EXAMPLE_B now serve as placeholders
 * rather than values: the shape of each answer stays visible without the
 * visitor editing someone else's figures. Nothing is entered, so there is
 * nothing to compute at build time and the results carry an empty state
 * until both rents and both vacancy lengths are in.
 */
const c = compare(EXAMPLE_A, EXAMPLE_B, HORIZON_MONTHS);

const panels = [
  {
    key: 'a',
    name: 'Rent sooner',
    tagline: 'Lower rent, leased quickly',
    scenario: EXAMPLE_A,
    result: c.a,
    accent: 'border-blue-500',
  },
  {
    key: 'b',
    name: 'Wait for more',
    tagline: 'Higher rent, longer empty',
    scenario: EXAMPLE_B,
    result: c.b,
    accent: 'border-gold',
  },
] as const;
---

<div class="panel" id="rental-comparison" data-ready="false">
  <form id="comparison-form" novalidate onsubmit="return false">
    {/* ------------------------------------------------ the two scenarios */}
    <div class="grid gap-6 md:grid-cols-2">
      {
        panels.map((panel) => (
          <fieldset
            class={`rounded-lg border-t-4 bg-surface-2 p-5 md:p-6 ${panel.accent}`}
            data-panel={panel.key}
          >
            <legend class="sr-only">
              {panel.name}: {panel.tagline}
            </legend>

            <div class="flex items-baseline justify-between gap-3">
              <p class="font-serif text-h3 font-semibold text-ink">{panel.name}</p>
              <p class="text-sm font-medium text-ink-muted">{panel.tagline}</p>
            </div>

            <div class="mt-5 space-y-4">
              <div>
                <label for={`c-${panel.key}-rent`} class="field-label">
                  Monthly rent
                </label>
                <div class="relative">
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"
                  >
                    $
                  </span>
                  <input
                    id={`c-${panel.key}-rent`}
                    name={`${panel.key}Rent`}
                    type="number"
                    inputmode="numeric"
                    min="0"
                    step="25"
                    placeholder={String(panel.scenario.rent)}
                    class="field-input tabular-nums pl-7"
                  />
                </div>
              </div>

              <div>
                <div class="flex items-baseline justify-between gap-3">
                  <label for={`c-${panel.key}-vacancy`} class="field-label mb-0">
                    Days until leased
                  </label>
                  <output
                    for={`c-${panel.key}-vacancy`}
                    data-out={`${panel.key}VacancyLabel`}
                    class="font-serif text-base font-semibold tabular-nums text-ink"
                  >
                    {days(0)}
                  </output>
                </div>
                <input
                  id={`c-${panel.key}-vacancy`}
                  name={`${panel.key}Vacancy`}
                  type="range"
                  min={SLIDER.vacancyDays.min}
                  max={SLIDER.vacancyDays.max}
                  step={SLIDER.vacancyDays.step}
                  value="0"
                  class="range-input mt-3"
                />
              </div>

            </div>

            <dl class="cmp-results mt-6 space-y-2 border-t border-line pt-4 text-sm">
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-ink-muted">Rent lost while empty</dt>
                <dd class="font-medium tabular-nums text-cost" data-out={`${panel.key}Lost`}>
                  {money(panel.result.lostToVacancy)}
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-ink-muted">Earning days in the window</dt>
                <dd class="font-medium tabular-nums text-ink" data-out={`${panel.key}EarningDays`}>
                  {Math.round(panel.result.earningDays)}
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-3 border-t border-line pt-2">
                <dt class="font-medium text-ink">
                  Income over <span data-out="periodMonths">{c.horizonMonths}</span>{' '}
                  months
                </dt>
                <dd
                  class="font-serif text-lg font-semibold tabular-nums text-ink"
                  data-out={`${panel.key}Income`}
                >
                  {money(panel.result.income)}
                </dd>
              </div>
            </dl>
          </fieldset>
        ))
      }
    </div>

    {/*
      One comparison period, not a lease length per scenario.

      Antonio asked for this control to be renamed, and he was right that
      "Lease duration" did not describe what an owner is choosing. It was
      also doing almost nothing: with the window pinned at twelve months,
      any lease of twelve months or more never bound, so three of its four
      options gave identical answers.

      It now sets the window both scenarios are measured over. The lease is
      assumed to cover that window, which is what the note below says.
    */}
    <div class="mt-6 max-w-xs">
      <label for="c-period" class="field-label">Comparison period</label>
      <select id="c-period" name="period" class="field-input">
        {COMPARISON_PERIODS.map((term) => (
          <option value={term} selected={term === HORIZON_MONTHS}>
            {term} months
          </option>
        ))}
      </select>
    </div>

    <button type="reset" class="btn btn-secondary mt-6">Reset comparison</button>

    {/* ------------------------------------------------------- the answer */}
    <output for="comparison-form" aria-live="polite" class="mt-10 block space-y-8">
      <p class="cmp-empty rounded-lg bg-surface-2 p-6 text-ink-muted md:p-7">
        Enter a monthly rent and the days until leased for both options, and
        the comparison will appear here.
      </p>

      <section
        aria-labelledby="cmp-verdict"
        class="cmp-results rounded-lg bg-surface-2 p-6 md:p-7"
      >
        {/*
          Figures, and no verdict.

          Antonio's instruction was to put the number in front of the owner
          and let them decide. The heading used to read "Waiting earns about
          $99 more", which is true but draws the conclusion for them, and a
          tool that keeps concluding for people reads as one that wants a
          particular answer. The heading is a label now; the three rows are
          the whole result; the box below invites the conversation where
          judgement actually belongs.
        */}
        <h3 id="cmp-verdict" class="font-serif text-h3 font-semibold text-ink">
          Projected rental income over <span data-out="periodMonths"
            >{c.horizonMonths}</span
          > months
        </h3>

        <dl class="mt-6 space-y-4">
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-ink-muted">Rent sooner</dt>
            <dd
              class="font-serif text-h3 font-semibold tabular-nums text-ink"
              data-out="totalA"
            >
              {money(c.a.income)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-ink-muted">Wait for more</dt>
            <dd
              class="font-serif text-h3 font-semibold tabular-nums text-ink"
              data-out="totalB"
            >
              {money(c.b.income)}
            </dd>
          </div>
          <div
            class="flex items-baseline justify-between gap-4 border-t border-line pt-4"
          >
            <dt class="font-medium text-ink" data-out="differenceLabel">
              Difference, in favour of waiting
            </dt>
            <dd
              class="font-serif text-h3 font-semibold tabular-nums text-band-text"
              data-out="difference"
            >
              {money(Math.abs(c.difference))}
            </dd>
          </div>
        </dl>

      </section>

      <section
        aria-labelledby="cmp-breakeven"
        class="cmp-results rounded-lg border border-line p-6 md:p-7"
      >
        <h3 id="cmp-breakeven" class="font-serif text-h3 font-semibold text-ink">
          How Long Can You Afford to Wait?
        </h3>

        {/*
          The figure is how many days BEYOND scenario B's own estimate the
          owner could keep waiting. The arithmetic was right; the old label,
          "Break-even additional vacancy", did not say what it was additional
          to, which is what made Antonio read it as a total.
        */}
        {/*
          One sentence with the number inside it, rather than a label, a
          figure and an explanation of what the label meant.

          The paragraph of assumptions that used to close this box repeated,
          nearly word for word, the "What these tools assume" section further
          down the same page. Saying it twice did not make it truer and it
          buried the one number the box exists to give.
        */}
        <p class="mt-4 text-sm font-semibold uppercase tracking-[0.08em] text-ink-muted">
          You could wait about
        </p>
        <p
          class="mt-1 font-serif text-h2 font-semibold tabular-nums text-band-text"
          data-out="breakEven"
        >
          {days(c.breakEvenExtraDays)}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink" data-out="breakEvenNote">
          longer than the {days(c.b.vacancyDays)} you entered, before the
          higher rent stops being worth it — about {days(
            c.b.vacancyDays + c.breakEvenExtraDays
          )} empty in total.
        </p>
      </section>
    </output>
  </form>

  <noscript>
    <p class="mt-6 rounded-md bg-surface-3 px-4 py-3 text-sm text-ink">
      This comparison is worked out in your browser, which needs JavaScript.
      With it switched off, nothing is calculated &mdash; or
      <a href="/contact" class="underline underline-offset-2">tell us about your property</a>
      and we will work it through with you.
    </p>
  </noscript>
</div>

<style>
  /*
    One attribute on the root swaps the empty state for the answer, the same
    way the vacancy calculator does it. CSS rather than inline display,
    because the production Content-Security-Policy drops style attributes.
  */
  #rental-comparison[data-ready='false'] .cmp-results,
  #rental-comparison[data-ready='true'] .cmp-empty {
    display: none;
  }
</style>

<script>
  import {
    compare,
    days,
    HORIZON_MONTHS,
    money,
    type Scenario,
  } from '~/lib/pricing';

  const form = document.getElementById('comparison-form') as HTMLFormElement | null;

  if (form) {
    const root = document.getElementById('rental-comparison');
    const out = (key: string) => root?.querySelector<HTMLElement>(`[data-out="${key}"]`);

    const num = (name: string) =>
      Number((form.elements.namedItem(name) as HTMLInputElement | null)?.value);

    const period = () => num('period') || HORIZON_MONTHS;

    /*
      The lease is given the same length as the comparison period, so the
      lease cap inside compare() never binds. The owner is choosing a window
      to compare over, not a lease term, and the note under the result says
      the lease is assumed to cover it.
    */
    const readScenario = (prefix: 'a' | 'b'): Scenario => ({
      rent: num(`${prefix}Rent`),
      vacancyDays: num(`${prefix}Vacancy`),
      leaseMonths: period(),
    });

    const set = (key: string, value: string) => {
      const el = out(key);
      if (el) el.textContent = value;
    };

    /** The period appears in both scenario panels, so set every copy. */
    const setAll = (key: string, value: string) => {
      root
        ?.querySelectorAll<HTMLElement>(`[data-out="${key}"]`)
        .forEach((el) => {
          el.textContent = value;
        });
    };

    let latest = { a: readScenario('a'), b: readScenario('b') };

    const render = () => {
      const a = readScenario('a');
      const b = readScenario('b');
      latest = { a, b };
      const months = period();
      const result = compare(a, b, months);
      setAll('periodMonths', String(result.horizonMonths));

      /*
        Both sides have to be filled in before a comparison means anything.
        With one rent missing the tool would cheerfully report the other
        option winning by its entire income, which is not a finding.

        A vacancy of zero days is a legitimate answer on its own - a tenant
        lined up for the day the last one leaves - but zero on BOTH sides
        with the sliders untouched is the untouched state, not a scenario,
        so the comparison waits for at least one of them to move.
      */
      if (root) {
        const ready =
          a.rent > 0 &&
          b.rent > 0 &&
          (a.vacancyDays > 0 || b.vacancyDays > 0);
        root.dataset.ready = ready ? 'true' : 'false';
      }

      for (const [key, scenario, side] of [
        ['a', a, result.a],
        ['b', b, result.b],
      ] as const) {
        set(`${key}VacancyLabel`, days(scenario.vacancyDays));
        set(`${key}Lost`, money(side.lostToVacancy));
        set(`${key}EarningDays`, String(Math.round(side.earningDays)));
        set(`${key}Income`, money(side.income));
      }

      set('totalA', money(result.a.income));
      set('totalB', money(result.b.income));

      /*
        The difference, named but not judged. "In favour of" states which
        way the gap runs; it does not tell the owner what to do about it.
      */
      set('difference', money(Math.abs(result.difference)));
      set(
        'differenceLabel',
        result.winner === 'tie'
          ? 'Difference'
          : result.winner === 'a'
            ? 'Difference, in favour of renting sooner'
            : 'Difference, in favour of waiting'
      );

      set('breakEven', days(result.breakEvenExtraDays));
      set(
        'breakEvenNote',
        result.bAlreadyBehind
          ? 'Waiting is already behind at these figures, so there is no extra time to absorb.'
          : `longer than the ${days(result.b.vacancyDays)} you entered, before the higher rent stops being worth it ${'—'} about ${days(result.b.vacancyDays + result.breakEvenExtraDays)} empty in total.`
      );
    };

    form.addEventListener('input', render);
    form.addEventListener('reset', () => window.setTimeout(render, 0));

    document
      .getElementById('send-comparison-figures')
      ?.addEventListener('click', () => {
        const months = period();
        const result = compare(latest.a, latest.b, months);
        const summary = [
          'My figures from the rental pricing comparison:',
          '',
          `Comparison period: ${months} months`,
          `Rent sooner: ${money(latest.a.rent)} per month, leased in ${days(latest.a.vacancyDays)}`,
          `Wait for more: ${money(latest.b.rent)} per month, leased in ${days(latest.b.vacancyDays)}`,
          '',
          `Renting sooner earns: ${money(result.a.income)}`,
          `Waiting earns: ${money(result.b.income)}`,
          `Difference: ${money(Math.abs(result.difference))} in favour of ${result.winner === 'a' ? 'renting sooner' : 'waiting'}`,
          `Additional days you could wait beyond the estimate: ${days(result.breakEvenExtraDays)}`,
          '',
          'I would like a personalized rental evaluation.',
        ].join('\n');

        try {
          sessionStorage.setItem('ma:tool-summary', summary);
        } catch {
          // Storage blocked; the link still works without the figures.
        }
      });

    render();
  }
</script>
