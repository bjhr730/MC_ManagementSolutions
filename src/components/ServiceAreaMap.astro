---
import {
  MAP_CONTEXT,
  MAP_PLACES,
  MAP_SERVED,
  MAP_VIEWBOX,
} from '~/data/service-area-map';
import { SERVICE_AREAS } from '~/config/site';

/*
  Positions come from this generated stylesheet, keyed on data-area, not
  from style attributes. The site's CSP has no 'unsafe-inline', so a style
  attribute is dropped in production while working fine in dev - which put
  every label in a heap in the corner of the deployed page once already.
  The generator writes this file alongside the path data.
*/
import '~/styles/service-area-map.css';

/**
 * The Northern Virginia service area, drawn from real county boundaries.
 *
 * The shapes come from scripts/prepare-service-map.mjs, which projects the
 * US Census boundaries for the five jurisdictions in SERVICE_AREAS. Nothing
 * is fetched at runtime and there is no map tile, no API key and no JS: it
 * is one inline SVG, so it costs a few KB of HTML and works offline.
 *
 * The labels are HTML, not SVG <text>, on purpose. SVG text scales with the
 * viewBox, so at 375px wide a label sized to look right on a desktop lands
 * at about 7px. As HTML they are positioned as a percentage of the canvas
 * and sized in rem, so they stay readable at every width. Every stroke uses
 * vector-effect: non-scaling-stroke for the same reason.
 *
 * The map is decorative in the strict sense - the <dl> beside it names every
 * county and the places inside it, and carries detail no map at this size
 * could. So the SVG gets one accessible name and the label layer is hidden
 * from assistive technology, which would otherwise read the names twice.
 */
const title = 'service-area-map-title';
const names = MAP_SERVED.map((area) => area.label).join(', ');

/**
 * What each county reads out when it is the selected one.
 *
 * The map answers "is my property in the area" at a glance, but on a phone
 * the town names are too small to draw and the list that names them can be
 * a screen away - so tapping a county would change a colour somewhere and
 * tell the person nothing. This puts the answer directly under the map.
 *
 * Built from SERVICE_AREAS, the same source the list renders from, so the
 * two cannot say different things. Matching by slug, the same contract the
 * generator checks.
 */
const slug = (county: string) =>
  county
    .replace(/^City of /, '')
    .replace(/ County$/, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-');

const readouts = SERVICE_AREAS.map((area) => ({
  id: slug(area.county),
  county: area.county,
  detail: [area.places.join(', '), area.suffix].filter(Boolean).join(', '),
}));

const labelled = [
  ...MAP_SERVED.map((area) => ({ ...area, kind: 'served' as const })),
  ...MAP_CONTEXT.map((area) => ({ ...area, kind: 'context' as const })),
];
---

<figure class="service-map">
  <div class="service-map-canvas">
    <svg viewBox={MAP_VIEWBOX} role="img" aria-labelledby={title}>
      <title id={title}>
        Map of the Northern Virginia service area, covering {names}, with
        Washington, D.C. shown only for orientation.
      </title>

      {/* Context first, so the served areas sit over it where they meet. */}
      {
        MAP_CONTEXT.map((area) => (
          <path class="service-map-context" d={area.outline} />
        ))
      }

      {/*
        A heavy stroke on every silhouette, painted *under* the fills.

        The fills cover its inner half, and along a border between two
        counties they cover it from both sides, so it survives only on the
        outside of the territory as a whole. That gives the outer edge more
        weight than the county divisions without anyone having to compute
        the union of five polygons: the five areas read as one service area
        with counties inside it, rather than as five separate shapes.
      */}
      {
        MAP_SERVED.map((area) => (
          <path class="service-map-halo" d={area.outline} pathLength="1" />
        ))
      }

      {/*
        Fill uses the full path, which includes the enclave cities, so a
        county reads as solid. The edge uses the silhouette only, so the
        boundary of Fairfax City inside Fairfax County is not drawn.
      */}
      {
        MAP_SERVED.map((area) => (
          <path class="service-map-fill" d={area.d} data-area={area.id} />
        ))
      }
      {
        MAP_SERVED.map((area) => (
          <path class="service-map-edge" d={area.outline} />
        ))
      }

      {
        labelled
          .filter((area) => area.leader)
          .map((area) => <path class="service-map-leader" d={area.leader!} />)
      }
    </svg>

    {/*
      Labels and the dots that anchor the two callouts. Hidden from assistive
      technology: the SVG above already carries the accessible name and the
      list beside the map carries the detail.
    */}
    <div class="service-map-labels" aria-hidden="true">
      {/*
        Towns. Dots at every width, names only from 40rem up - at phone size
        seventeen names over a 335px map is a thicket, and the list below
        carries every one of them anyway.
      */}
      {
        MAP_PLACES.map((place) => (
          <span
            class="service-map-place"
            data-place={place.id}
            data-area={place.area}
          />
        ))
      }
      {
        MAP_PLACES.filter((place) => place.labelled).map((place) => (
          <span class="service-map-place-label" data-place={place.id}>
            {place.name}
          </span>
        ))
      }

      {
        labelled
          .filter((area) => area.dotX !== null)
          .map((area) => <span class="service-map-dot" data-area={area.id} />)
      }
      {/*
        A served county's name is a <label> for the radio that lives beside
        its entry in the list, so tapping the name on the map selects the
        county - the same control, reachable from either half. D.C. is not
        a service area and gets a plain span with nothing to select.

        pointer-events come back on here: the layer above turns them off so
        the pointer can reach the shapes, but these have to be tappable.
      */}
      {
        labelled.map((area) =>
          area.kind === 'served' ? (
            <label
              class:list={[
                'service-map-label',
                'is-served',
                area.leader && 'is-callout',
              ]}
              data-area={area.id}
              for={`map-area-${area.id}`}
            >
              {area.label}
            </label>
          ) : (
            <span
              class:list={[
                'service-map-label',
                'is-context',
                area.leader && 'is-callout',
              ]}
              data-area={area.id}
            >
              {area.label}
            </span>
          )
        )
      }
    </div>
  </div>

  {/*
    The readout. One line of prose per county, revealed when that county is
    the selected one, with a prompt in its place until then - which is also
    the only thing telling a touch user the map can be tapped at all.

    aria-live so a screen-reader user who changes the selection with the
    arrow keys hears what changed. The region keeps a minimum height so
    swapping between a short county and a long one does not shift the page
    under the reader's finger.
  */}
  <figcaption class="service-map-readouts" aria-live="polite">
    <p class="service-map-hint">
      Select a county to see the towns we manage in.
    </p>
    {
      readouts.map((area) => (
        <p class="service-map-readout" data-area={area.id}>
          <span class="service-map-readout-county">{area.county}</span>
          {area.detail && <span class="service-map-readout-detail">{area.detail}</span>}
        </p>
      ))
    }
  </figcaption>
</figure>

<style>
  .service-map {
    margin: 0;
  }

  .service-map-canvas {
    position: relative;
    width: 100%;
  }

  .service-map-canvas svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
    The served territory reads as raised off the band it sits on, the same
    way a card does, which is why it takes --color-surface rather than a
    tint. Section tone is `muted`, so that is surface over surface-2.
  */
  .service-map-fill {
    fill: var(--color-surface);
  }

  /*
    The territory's outer edge. Only the outer half of this is ever seen -
    see the comment on the markup - so it reads at about half its width.
  */
  .service-map-halo {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 6;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* The county divisions inside the territory, deliberately lighter. */
  .service-map-edge {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.25;
    stroke-linejoin: round;
    /*
      Keeps every line the same width whatever the map is scaled to. Without
      it the borders are hairlines at 375px and heavy on a wide desktop.
    */
    vector-effect: non-scaling-stroke;
  }

  /* At phone size the same widths read as much heavier, so ease them off. */
  @media (max-width: 40rem) {
    .service-map-halo {
      stroke-width: 4;
    }

    .service-map-edge {
      stroke-width: 1;
    }
  }

  /* D.C. is orientation, not territory: outline only, and never filled. */
  .service-map-context {
    fill: none;
    stroke: var(--color-ornament);
    stroke-width: 1.5;
    stroke-dasharray: 7 7;
    vector-effect: non-scaling-stroke;
  }

  /* Gold, used only here and on the two dots: the sparing accent. */
  .service-map-leader {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .service-map-labels {
    position: absolute;
    inset: 0;
    /*
      The layer sits over the whole SVG, so left alone it would swallow the
      hover that lights a county - the pointer would never reach the shape
      underneath. Nothing in here needs to be hovered itself.
    */
    pointer-events: none;
  }

  /* A town. Accent rather than gold: gold stays for the two callouts. */
  .service-map-place {
    position: absolute;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
    transition: transform var(--duration-base, 0.2s)
      var(--ease-out-quiet, ease-out);
  }

  .service-map-place-label {
    position: absolute;
    white-space: nowrap;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-ink-muted);
  }

  /*
    Town names are laid out by the generator against the widths they take at
    desktop size. Below that the map is too small to hold them, so the dots
    carry the detail and the list carries the names.
  */
  @media (max-width: 40rem) {
    .service-map-place-label {
      display: none;
    }
  }

  .service-map-dot {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-gold);
    transform: translate(-50%, -50%);
  }

  .service-map-label {
    position: absolute;
    transform: translate(-50%, -50%);
    /*
      Labels sitting on a shape wrap rather than run over its border.
      "Prince William" is the one that needs it: the county's largest
      inscribed circle is about 49px across at desktop and 24px on a phone,
      and the name on one line is 96px and 76px. Every other name on the map
      is a single word, so this only ever splits that one.
    */
    max-width: 5.5em;
    text-align: center;
    text-wrap: balance;
    font-size: clamp(0.6875rem, 1.45vw, 0.875rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-ink);
  }

  /*
    A callout label hangs off the end of its leader line, so it starts there
    and stays on one line - it sits on the band, not on a shape, and there
    is nothing for it to run over.
  */
  .service-map-label.is-callout {
    transform: translate(0, -50%);
    max-width: none;
    white-space: nowrap;
    text-align: left;
  }

  .service-map-label.is-context {
    font-weight: 500;
    color: var(--color-ink-muted);
  }

  /*
    A served county's name is a control, so it takes the pointer back from
    the layer (which switches them off so hover can reach the shapes) and
    carries enough padding to clear the 24px minimum target of WCAG 2.5.8.
    The padding grows the box around the same centre, so the collision
    layout the generator computed still holds.
  */
  .service-map-label.is-served {
    pointer-events: auto;
    cursor: pointer;
    /*
      0.375rem, not 0.3125rem: at 11px/1.15 the text box is 13px, and the
      smaller padding left the target 23px tall - one pixel under the 24px
      WCAG 2.5.8 minimum. Measured, not guessed.
    */
    padding: 0.375rem 0.5rem;
    margin: -0.375rem -0.5rem;
    border-radius: 0.1875rem;
    -webkit-tap-highlight-color: transparent;
  }

  /*
    The readout under the map. Which one shows is decided by the generated
    stylesheet, which knows the county ids; everything here is appearance.
    min-height holds four lines so the longest county - Fairfax, with
    eleven towns - does not push the page down when it is picked.
  */
  .service-map-readouts {
    margin-top: 0.875rem;
    /*
      Reserved for the longest county. Measured, not guessed: Fairfax with
      its eleven towns takes 75px at 375px wide and 48px once the line has
      room to run, so the narrow case holds more. Without this the block
      grows under the finger that just tapped it.
    */
    min-height: 4.75rem;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  @media (min-width: 40rem) {
    .service-map-readouts {
      min-height: 3.25rem;
    }
  }

  .service-map-readout {
    display: none;
    margin: 0;
  }

  .service-map-hint {
    margin: 0;
  }

  .service-map-readout-county {
    display: block;
    font-weight: 600;
    color: var(--color-ink);
  }

  /*
    The outer edge draws itself on as the map scrolls into view.

    This obeys the standing rule that motion may move a thing but never
    reveal it: the counties, their fills, their divisions, every town and
    every label are all painted and legible before this starts and while it
    runs. The only thing animating is the emphasis stroke around the
    outside, and pathLength="1" normalises five paths of different lengths
    so they draw together rather than finishing at five different moments.

    If animation-timeline is not supported the declaration is dropped and
    the edge is simply there from the start, which is the same end state.
  */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .service-map-halo {
        stroke-dasharray: 1;
        animation: service-map-draw linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 38%;
      }
    }
  }

  @keyframes service-map-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
