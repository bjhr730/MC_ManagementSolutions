---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import FaqList from '~/components/FaqList.astro';
import FounderPortrait from '~/components/FounderPortrait.astro';
import Icon from '~/components/Icon.astro';
import JsonLd from '~/components/JsonLd.astro';
import PathChooser from '~/components/PathChooser.astro';
import Section from '~/components/Section.astro';

import { HERO, HOME_FOUNDER_TEASER, TOOLS_TEASER } from '~/content/home';
import { SERVICE_COUNTIES_SHORT } from '~/config/site';
import { Image } from 'astro:assets';
import heroPhoto from '~/assets/photos/neighborhood.webp';
import { FEATURED_FAQ } from '~/content/faq';
import { SERVICES } from '~/content/services';
import { founderPerson, localBusiness } from '~/lib/schema';
import { computeVacancy, EXAMPLE, money } from '~/lib/vacancy';

// Three questions is enough on the home page; the rest are one click away.
const featured = FEATURED_FAQ.slice(0, 3);

// The teaser figure comes from the calculator so the two can never disagree.
// Rent plus carrying costs only; turnover is excluded and the caption says so.
const example = computeVacancy(EXAMPLE);
const exampleCost = money(example.lostRent + example.carryingCost);
---

<BaseLayout
  title="MC Management Solutions | Northern Virginia Property Management"
  description="Residential property management for Northern Virginia owners, run by a licensed broker who owns rental property himself. Transparent reporting, no termination fees, management shaped around you."
>
  <JsonLd slot="head" schema={localBusiness()} />
  <JsonLd slot="head" schema={founderPerson()} />

  {/* ---------------------------------------------------------------- Hero */}
  {/*
    Full-bleed photograph with the headline over it.

    The text sits on a scrim, not on the picture: a gradient from near-solid
    navy on the left to almost clear on the right. That is what makes white
    text safe here — measured against the rendered pixels, not assumed — and
    it is why the headline block is capped at max-w-2xl, so no line of text
    ever reaches the part of the scrim that has thinned out.
  */}
  <section class="hero relative isolate overflow-hidden border-b border-line">
    <Image
      src={heroPhoto}
      alt=""
      widths={[900, 1400, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-photo absolute inset-0 -z-20 size-full object-cover"
    />
    <div aria-hidden="true" class="hero-scrim absolute inset-0 -z-10"></div>

    {/*
      Measured, not guessed: at py-36 the primary call to action finished
      28px below the fold on a 900px-tall screen. The hero is the one place
      where "fills the screen" must not beat "the button is on the screen".
    */}
    <div class="container-page relative py-16 md:py-20 lg:py-24">
      <div class="max-w-2xl">
        {/*
          The counties, right at the top: the first question an owner has is
          whether this company covers where their property is.
        */}
        <p
          class="hero-in hero-in-1 flex flex-wrap items-center gap-x-2 gap-y-1 font-sans text-xs font-semibold uppercase tracking-[0.14em] text-silver-200"
        >
          {
            SERVICE_COUNTIES_SHORT.map((county, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class="text-gold-300">
                    &middot;
                  </span>
                )}
                <span>{county}</span>
              </>
            ))
          }
        </p>

        <h1 class="hero-in hero-in-2 mt-5 text-hero text-balance text-white">
          <span class="text-gold-300">{HERO.headlineLead}</span>{' '}
          {HERO.headlineRest}
        </h1>

        <p class="hero-in hero-in-3 mt-6 max-w-xl text-lead text-silver-200">
          {HERO.subhead}
        </p>

        <div class="hero-in hero-in-4 mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={HERO.primaryCta.href} class="btn btn-gold">
            {HERO.primaryCta.label}
          </a>
          <a href={HERO.secondaryCta.href} class="btn btn-on-photo">
            {HERO.secondaryCta.label}
          </a>
        </div>
      </div>

    </div>
  </section>

  {/* -------------------------------------------------- Pick your situation */}
  <Section labelledby="path-legend">
    <PathChooser />
  </Section>

  {/* ------------------------------------------------------------ Services */}
  <Section tone="band" labelledby="services-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="services-heading" class="max-w-2xl text-h2">
        Everything the property needs, in one place
      </h2>
      <a
        href="/services"
        class="text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
      >
        See all services
      </a>
    </div>

    {/*
      Cards rather than a list of seven links. As a plain row list this read
      as a table of contents; the service is the product, so it should look
      like something rather than like navigation.
    */}
    <ul class="reveal-group reveal-stagger mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.map((service) => (
          <li>
            <a
              href={`/services#${service.slug}`}
              class="media-card flex h-full items-start gap-4 rounded-xl border border-line bg-surface p-5"
            >
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-surface-3 text-accent">
                <Icon name={service.icon} class="size-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-ink">{service.title}</span>
                <span class="mt-1 block text-sm leading-relaxed text-ink-muted">
                  {service.summary}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* --------------------------------------------------------------- Tools */}
  {/*
    The one dark band on the page. The home page was five light sections in
    a row, so nothing told the eye where it had got to; this breaks that run
    and puts the weight on the single most persuasive thing here, which is a
    number an owner recognises as their own money.
  */}
  <Section tone="deep" labelledby="tools-heading">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p
          class="font-sans text-xs font-semibold uppercase tracking-[0.12em] text-band-deep-gold"
        >
          {TOOLS_TEASER.eyebrow}
        </p>
        <h2 id="tools-heading" class="mt-3 text-h2 text-on-band-deep">
          {TOOLS_TEASER.heading}
        </h2>
        <p class="mt-5 max-w-2xl text-lead text-band-deep-soft">
          {TOOLS_TEASER.body}
        </p>
        <a href={TOOLS_TEASER.href} class="btn btn-gold mt-8">
          {TOOLS_TEASER.cta}
        </a>
      </div>

      {/* A still of what the tool produces, so the link is not a leap. */}
      <div class="rounded-xl border border-white/15 bg-white/5 p-8 backdrop-blur-sm">
        <p
          class="text-sm font-semibold uppercase tracking-[0.08em] text-band-deep-soft"
        >
          A {EXAMPLE.vacancyDays}-day vacancy on a {money(EXAMPLE.rent)} rental
        </p>
        <p
          class="mt-3 font-serif text-hero font-semibold tabular-nums text-cost-on-deep"
        >
          {exampleCost}
        </p>
        <p class="mt-3 text-sm text-band-deep-soft">
          Lost rent plus carrying costs, before turnover.
        </p>
      </div>
    </div>
  </Section>

  {/* ------------------------------------------------------------- Founder */}
  <Section tone="muted" labelledby="founder-heading">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-center lg:gap-16">
      <FounderPortrait class="w-full max-w-sm" />

      <div>
        <p class="eyebrow">Meet the founder</p>
        <h2 id="founder-heading" class="mt-3 text-h2">Antonio Melendez Cabrera</h2>
        <p class="mt-2 text-sm font-medium text-ink-muted">
          Founder &middot; Real Estate Broker &middot; Property Investor
        </p>

        <blockquote class="mt-8 border-l-2 border-gold pl-5">
          <p class="font-serif text-lead text-ink italic">
            &ldquo;Your property deserves the same attention, care, and
            commitment I would give my own.&rdquo;
          </p>
        </blockquote>

        <p class="mt-7 text-ink-muted">{HOME_FOUNDER_TEASER}</p>

        <a
          href="/founder"
          class="mt-7 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
        >
          Read Antonio&rsquo;s full background
        </a>
      </div>
    </div>
  </Section>

  {/* ----------------------------------------------------------------- FAQ */}
  <Section tone="band" labelledby="faq-heading">
    <div class="max-w-3xl">
      <h2 id="faq-heading" class="text-h2">The ones owners ask first</h2>
      <div class="mt-8">
        <FaqList entries={featured} />
      </div>
      <a
        href="/faq"
        class="mt-8 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
      >
        All owner questions
      </a>
    </div>
  </Section>

  <Cta />
</BaseLayout>
