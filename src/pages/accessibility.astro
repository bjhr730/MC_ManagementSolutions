---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import { CONTACT, LEGAL_ENTITY } from '~/config/site';

/*
 * Antonio's wording, November 2026. This replaced a longer statement that
 * listed the specific conformance work - keyboard operation, contrast
 * ratios, native disclosure elements, reduced motion, tap target sizes -
 * and named what had not been tested yet.
 *
 * The site still does all of those things; only the page saying so is
 * shorter. Worth knowing if a conformance claim is ever needed in writing,
 * because this version does not make one.
 *
 * The phone number comes from CONTACT rather than being typed out, so it
 * cannot drift from the number in the footer and the structured data.
 */
---

<BaseLayout
  title="Accessibility"
  description="MC Management Solutions is committed to an accessible, user-friendly website. Contact us if you have difficulty accessing any part of it."
>
  <PageHeader
    eyebrow="Accessibility"
    title="Accessibility statement"
    lead={`${LEGAL_ENTITY} is committed to providing an accessible and user-friendly website for all visitors.`}
  />

  <Section>
    <div class="prose-site">
      <p>
        We strive to make our website easy to navigate and accessible to
        individuals with disabilities.
      </p>
      <p>
        If you experience difficulty accessing any part of our website or need
        assistance obtaining information, please contact us at <a
          href={CONTACT.phoneHref}>{CONTACT.phone}</a
        >. We will be happy to assist you.
      </p>
    </div>
  </Section>
</BaseLayout>
