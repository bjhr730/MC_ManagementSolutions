---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Disclosure from '~/components/Disclosure.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import RentalComparison from '~/components/RentalComparison.astro';
import Section from '~/components/Section.astro';
import ToolCta from '~/components/ToolCta.astro';
import VacancyCalculator from '~/components/VacancyCalculator.astro';

import { breadcrumbs } from '~/lib/schema';

/*
  Antonio put the pricing comparison first in November 2026: it answers the
  decision an owner is actually weighing, where the vacancy calculator
  explains a cost they may not have thought about yet.

  The names and blurbs are his wording. They ask a question rather than
  describing a mechanism, which is what he wanted.
*/
const tools = [
  {
    id: 'pricing-comparison',
    name: 'Should You Wait for Higher Rent?',
    blurb:
      'Compare renting sooner at a lower price against waiting for a higher ' +
      'offer, and see which could put more rental income in your pocket.',
  },
  {
    id: 'vacancy-cost',
    name: 'What Is Vacancy Really Costing You?',
    blurb:
      'See how lost rent, ongoing expenses and turnover costs affect your ' +
      'rental property finances.',
  },
];
---

<BaseLayout
  title="Owner Tools"
  description="Two free tools for Northern Virginia rental owners: what a vacancy costs, and whether waiting for a higher rent is worth it. No sign-up, no email required."
>
  <JsonLd slot="head" schema={breadcrumbs([{ name: 'Owner Tools', path: '/tools' }])} />

  <PageHeader
    photo="numbers"
    eyebrow="Owner tools"
    title="Run the numbers on your rental"
    lead="Two tools for the decisions that cost owners the most money. Free to use, nothing is sent anywhere, and no email is required to see your results."
  />

  <Section tone="band" compact>
    <nav aria-label="Tools on this page">
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          tools.map((tool, index) => (
            <li>
              <a
                href={`#${tool.id}`}
                class="rule-hover card-lift block h-full card"
              >
                <p class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-accent">
                  Tool {index + 1}
                </p>
                <p class="mt-2 font-serif text-h3 font-semibold text-ink">
                  {tool.name}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                  {tool.blurb}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Section>

  {/* -------------------------------------------- pricing comparison */}
  <Section labelledby="pricing-comparison-heading">
    <div id="pricing-comparison" class="scroll-mt-28">
      <p class="eyebrow">Rental pricing</p>
      <h2 id="pricing-comparison-heading" class="mt-3 text-h2">
        Should You Wait for Higher Rent?
      </h2>
      <p class="mt-4 max-w-2xl text-lead text-ink-muted">
        Compare renting sooner at a lower price against waiting for a higher
        offer, and see which could put more rental income in your pocket.
        Sometimes waiting is the better call; this works out when.
      </p>

      <div class="mt-10">
        <RentalComparison />
      </div>

      <ToolCta
        handoffId="send-comparison-figures"
        primary="evaluation"
        heading="What this means for you"
        body={[
          'A calculator can compare two numbers. It cannot tell you what your property will actually rent for, how long it will take, or what a tenant at that price is likely to be worth over a lease.',
          'Tell us about the property and we will work the figures through with you.',
        ]}
      />
    </div>
  </Section>

  {/* ------------------------------------------------- vacancy cost */}
  <Section tone="band" labelledby="vacancy-cost-heading">
    <div id="vacancy-cost" class="scroll-mt-28">
      <p class="eyebrow">Vacancy</p>
      <h2 id="vacancy-cost-heading" class="mt-3 text-h2">
        What Is Vacancy Really Costing You?
      </h2>
      <p class="mt-4 max-w-2xl text-lead text-ink-muted">
        See how lost rent, ongoing expenses and turnover costs affect your
        rental property finances, with the costs that run regardless kept
        separate from the ones the vacancy actually causes.
      </p>

      <div class="mt-10">
        <VacancyCalculator />
      </div>

      <ToolCta
        handoffId="send-vacancy-figures"
        primary="conversation"
        heading="What Could These Numbers Mean for Your Property?"
        body={[
          'Every rental property is different. Your ideal rental price depends on market conditions, property features, location, and tenant demand.',
          'At MC Management Solutions, we believe informed decisions begin with understanding the numbers. Let’s discuss your property, your rental goals, and how we may be able to help you minimize vacancy and maximize your investment’s potential.',
        ]}
      />
    </div>
  </Section>

  {/* ------------------------------------------------ assumptions, plainly */}
  <Section labelledby="assumptions-heading">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="prose-site">
        <h2 id="assumptions-heading" class="text-h2">What these tools assume</h2>

        <h3>Both tools</h3>
        <p>
          Monthly figures are converted to daily ones using an average month
          of about 30.4 days. Every result is an estimate built on the numbers
          you enter.
        </p>

        <h3>What Is Vacancy Really Costing You?</h3>
        <p>
          Carrying costs are shown separately because a mortgage payment, HOA
          fee and insurance premium are owed whether or not anyone is living
          there. They are not caused by the vacancy; what the vacancy does is
          remove the rent that would have met them. That is why the headline
          figure is the vacancy-related impact and leaves them out, with the
          combined figure shown separately underneath it.
        </p>

        <h3>Should You Wait for Higher Rent?</h3>
        <p>
          Both options are measured over the same comparison period, starting
          today. That matters: giving each option a full year of rent from
          the day it is let would ignore the waiting entirely, and on that
          basis a higher rent always wins, which makes the comparison
          useless.
        </p>
        <p>
          The property earns nothing while empty and the rent stays constant.
          The lease is assumed to run for at least the comparison period, so
          no second vacancy, renewal, rent increase or further turnover
          expense is modelled. Mortgage, HOA and insurance costs are left out
          because they are the same under both options; including them would
          be double counting and would understate how long you can afford to
          wait.
        </p>
      </div>

      <div>
        <Disclosure label="Please read">
          <p>
            These calculators provide general estimates for educational
            purposes only. Results are based on user-provided assumptions and
            do not constitute financial, tax, legal, or investment advice.
            Actual rental performance and vacancy periods may vary.
          </p>
        </Disclosure>

        <div class="mt-8 card">
          <h2 class="font-serif text-base font-semibold text-ink">
            Your figures stay with you
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Everything you type is worked out in your own browser. Nothing is
            sent to us, stored, or required before you see your results. If you
            choose to request a rental evaluation, the figures are copied into
            the message box on our contact form so you can check them before
            anything is sent.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* ------------------------------------------------ closing, Antonio's */}
  {/*
    Antonio's wording, November 2026, and the page's first proper close -
    it used to end on a privacy note, which is a fine thing to say and a
    poor thing to finish on.

    Navy, because this is the one claim the tools are building towards and
    the band is what the palette uses for a claim. The button goes to the
    form itself rather than the top of the contact page, matching the one
    on Management Plans.
  */}
  <Section tone="deep" labelledby="smart-pricing-heading">
    <div class="max-w-2xl">
      <h2 id="smart-pricing-heading" class="text-h2 text-on-band-deep">
        Smart Pricing. Better Long-Term Returns.
      </h2>
      <p class="mt-5 text-lead text-band-deep-soft">
        The highest rent doesn’t always mean the highest return.
      </p>
      <p class="mt-4 text-band-deep-soft">
        Setting the right rental price is about finding the balance between
        maximizing income, minimizing vacancy, and protecting your long-term
        investment.
      </p>

      <a href="/contact#inquiry" class="btn btn-gold mt-8">
        Let’s Talk About Your Property
      </a>
    </div>
  </Section>
</BaseLayout>
