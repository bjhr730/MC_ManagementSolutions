---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Disclosure from '~/components/Disclosure.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import VacancyCalculator from '~/components/VacancyCalculator.astro';

import { breadcrumbs } from '~/lib/schema';
---

<BaseLayout
  title="Owner Tools"
  description="A vacancy cost calculator for Northern Virginia rental owners: what an empty property actually costs per day, and how long you can afford to hold out for a higher rent."
>
  <JsonLd slot="head" schema={breadcrumbs([{ name: 'Owner Tools', path: '/tools' }])} />

  <PageHeader
    eyebrow="Owner tools"
    title="Vacancy Cost Calculator"
    lead="An empty property costs money every day it sits. This works out how much, and whether holding out for a higher rent is worth the wait."
  />

  <Section tone="sage">
    <VacancyCalculator />

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="prose-site">
        <h2 class="text-h2">How the numbers work</h2>
        <p>
          Lost rent and carrying costs are both converted to a daily figure
          using an average month of 30.4 days, then multiplied by the days
          vacant. Turnover costs are added once, not per day.
        </p>
        <p>
          The break-even figure is the part owners most often get wrong. A
          higher rent earns you the difference every month of the lease, so
          over twelve months it is worth twelve times the increase. Divide
          that by what a day empty costs you, and you get the number of extra
          vacant days the increase can absorb before you are behind.
        </p>
        <p>
          It is deliberately simple. It does not model taxes, depreciation,
          rent growth, or the risk that a tenant who only accepted a stretched
          rent leaves at the first renewal.
        </p>
      </div>

      <div>
        <Disclosure label="A note on this tool">
          <p>
            This calculator is a general estimate for planning purposes. It is
            not financial, tax or investment advice, and it does not account
            for the specifics of your property or your circumstances. Actual
            vacancy periods depend on the market, the season, the condition of
            the property and the rent you ask.
          </p>
        </Disclosure>

        <div class="mt-8 rounded-lg border border-line bg-surface-2 p-6">
          <h2 class="font-serif text-base font-semibold text-ink">
            Want the real number for your property?
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            A rental evaluation looks at what comparable homes in your area
            are actually renting for and how long they are taking to lease,
            rather than an average month.
          </p>
          <a href="/contact" class="btn btn-secondary mt-5">
            Request a rental evaluation
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Cta />
</BaseLayout>
