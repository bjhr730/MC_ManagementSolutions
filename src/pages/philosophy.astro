---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';

import { PHILOSOPHY_HEADING, PRINCIPLES } from '~/content/philosophy';
import { TAGLINE } from '~/config/site';
import { breadcrumbs } from '~/lib/schema';
---

<BaseLayout
  title="Our Philosophy"
  description="Integrity over profit. Honesty, communication and transparency. Your property, our responsibility. The three principles behind M&A Management Solutions."
>
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Our Philosophy', path: '/philosophy' }])}
  />

  <PageHeader
    eyebrow="Our philosophy"
    title={PHILOSOPHY_HEADING}
    lead={TAGLINE}
  />

  <Section>
    <ol class="space-y-16 md:space-y-20">
      {
        PRINCIPLES.map((principle) => (
          <li class="rule-hover border-t border-line pt-8">
            <div class="max-w-2xl">
              <h2 class="text-h2">{principle.title}</h2>
              <p class="mt-5 font-serif text-lead text-accent italic">
                {principle.statement}
              </p>
              <p class="mt-5 text-lead text-ink-muted">{principle.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Cta
    heading="Hold Us to It."
    body="We believe trust is earned, not promised. Let's have a conversation about your property, your expectations, and what matters most to you. No pressure, no obligations. Just an honest conversation to see if we're the right fit."
    ctaLabel="Let's Talk About Your Property"
    showDisclosure={false}
  />
</BaseLayout>
