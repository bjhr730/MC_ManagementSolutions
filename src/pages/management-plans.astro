---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Disclosure from '~/components/Disclosure.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import Tick from '~/components/Tick.astro';

import {
  COVERAGE,
  FEES,
  NO_TERMINATION_FEE,
  PLANS_INTRO,
} from '~/content/management-plans';
import {
  PRICING_DISCLOSURE,
  TERMINATION_QUALIFIER,
} from '~/config/compliance';
import { breadcrumbs } from '~/lib/schema';
---

<BaseLayout
  title="Management Plans"
  description="Management services and pricing are customized to your property and goals, with every applicable fee disclosed in your written proposal. Request a personalized management proposal."
>
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Management Plans', path: '/management-plans' }])}
  />

  <PageHeader
    eyebrow="Management plans"
    title="Customized management, not a rate card"
    lead="Tell us about the property and what you want from management, and we will put a written proposal in front of you."
  />

  <Section labelledby="approach-heading">
    <div class="max-w-3xl">
      <h2 id="approach-heading" class="sr-only">Our pricing approach</h2>
      <p class="text-lead text-ink-muted">{PLANS_INTRO}</p>
    </div>
  </Section>

  <Section tone="muted" labelledby="coverage-heading">
    <div class="max-w-3xl">
      <h2 id="coverage-heading" class="text-h2">{COVERAGE.heading}</h2>
      <p class="mt-5 text-lead text-ink-muted">{COVERAGE.intro}</p>
    </div>

    <ul class="mt-10 grid gap-x-10 gap-y-4 md:grid-cols-2">
      {
        COVERAGE.items.map((item) => (
          <li class="flex gap-3">
            <Tick />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="fees-heading">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="fees-heading" class="text-h2">{FEES.heading}</h2>
        <p class="mt-5 text-ink-muted">{FEES.intro}</p>

        <div class="mt-8">
          <Disclosure label="Pricing">
            <p>{PRICING_DISCLOSURE}</p>
          </Disclosure>
        </div>
      </div>

      <div>
        <h3 class="text-h3">{FEES.lead}</h3>
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {
            FEES.items.map((item) => (
              <li class="py-4">
                <span class="font-medium text-ink">{item.label}</span>
                {'note' in item && item.note && (
                  <span class="mt-0.5 block text-sm text-ink-muted">
                    {item.note}
                  </span>
                )}
              </li>
            ))
          }
        </ul>

        <p class="mt-8 font-serif text-h3 text-ink">{FEES.closing}</p>
      </div>
    </div>
  </Section>

  <Section tone="inverse" labelledby="termination-heading">
    <div class="max-w-2xl">
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-bronze-300">
        No lock-in
      </p>
      <h2 id="termination-heading" class="mt-3 text-h2 text-white">
        {NO_TERMINATION_FEE.headline}
      </h2>
      <p class="mt-5 text-lead text-silver-200">{NO_TERMINATION_FEE.body}</p>
      <p class="mt-6 text-sm leading-relaxed text-silver-400">
        {TERMINATION_QUALIFIER}
      </p>
    </div>
  </Section>

  <Cta
    heading="Request a personalized management proposal"
    body="Send us the property details and we will come back with a proposal built around it, every applicable fee disclosed."
    showDisclosure={false}
  />
</BaseLayout>
