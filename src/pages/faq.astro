---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Disclosure from '~/components/Disclosure.astro';
import FaqList from '~/components/FaqList.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';

import { FAQ_INTRO, FAQ_SECTIONS } from '~/content/faq';
import { TAGLINE } from '~/config/site';
import { PRICING_DISCLOSURE } from '~/config/compliance';
import { breadcrumbs, faqPage } from '~/lib/schema';

const slug = (title: string) =>
  title
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Owner questions about involvement, fees, termination, maintenance, rental pricing, screening, statements, disbursements, HOA coordination and support for out-of-state and international owners."
>
  <JsonLd slot="head" schema={faqPage()} />
  <JsonLd
    slot="head"
    schema={breadcrumbs([
      { name: 'Frequently Asked Questions', path: '/faq' },
    ])}
  />

  <PageHeader
    photo="street-row"
    eyebrow="Frequently asked questions"
    title={TAGLINE}
    lead={FAQ_INTRO}
  />

  <Section>
    <div class="max-w-3xl">
      {/* Jump list: five sections is enough to be worth skipping between. */}
      <nav aria-label="FAQ sections" class="mb-14">
        <ul class="flex flex-wrap gap-2">
          {
            FAQ_SECTIONS.map((section) => (
              <li>
                <a
                  href={`#${slug(section.title)}`}
                  class="chip inline-flex min-h-11 items-center rounded-full border border-control-border px-4 text-sm font-medium text-ink"
                >
                  {section.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="space-y-14">
        {
          FAQ_SECTIONS.map((section) => (
            <section id={slug(section.title)} class="scroll-mt-28">
              <h2 class="flex items-center gap-3 text-h2">
                <span aria-hidden="true" class="h-6 w-1 rounded-full bg-gold" />
                {section.title}
              </h2>
              <div class="mt-6">
                <FaqList entries={section.entries} level="h3" />
              </div>
            </section>
          ))
        }
      </div>

      <div class="mt-12">
        <Disclosure label="Pricing">
          <p>{PRICING_DISCLOSURE}</p>
        </Disclosure>
      </div>

      <p class="mt-10 text-ink-muted">
        Still have a question? <a
          href="/contact"
          class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
          >Ask us directly</a
        > and we will answer it straight.
      </p>
    </div>
  </Section>

  <Cta />
</BaseLayout>
