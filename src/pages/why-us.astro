---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Disclosure from '~/components/Disclosure.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';

import { REASONS } from '~/content/why-us';
import { NO_TERMINATION_FEE } from '~/content/management-plans';
import { TERMINATION_QUALIFIER } from '~/config/compliance';
import { breadcrumbs } from '~/lib/schema';
---

<BaseLayout
  title="Why Choose Us"
  description="An owner's perspective, experience at both ends of the scale, transparency by default and no termination fees. Why Northern Virginia owners choose MC Management Solutions."
>
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Why Choose Us', path: '/why-us' }])}
  />

  <PageHeader
    photo="reporting"
    eyebrow="Why choose us"
    title="Why Choose Us"
    lead="Plenty of companies will collect your rent. Fewer will tell you the truth about your property when the news is bad."
  />

  <Section labelledby="reasons-heading">
    <h2 id="reasons-heading" class="sr-only">Reasons owners choose us</h2>
    {/*
      Cards rather than a bare two-column text grid. The numeral gives each
      reason an anchor the eye can land on, which is what this page was
      missing: six headings of similar length over six paragraphs of similar
      length read as one block of grey.

      The numerals are decorative and hidden from assistive technology —
      they imply a ranking that does not exist, and the list is already a
      list.
    */}
    <ul class="reveal-group grid gap-6 md:grid-cols-2">
      {
        REASONS.map((reason, i) => (
          <li class="relative rounded-xl border border-line bg-surface p-6 md:p-7">
            <span
              aria-hidden="true"
              class="font-serif text-h2 font-semibold leading-none text-gold"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-h3">{reason.title}</h3>
            <p class="mt-3 text-ink-muted">{reason.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="muted" labelledby="no-lock-in-heading">
    <div class="max-w-3xl">
      <p class="eyebrow">No lock-in</p>
      <h2 id="no-lock-in-heading" class="mt-3 text-h2">
        {NO_TERMINATION_FEE.headline}
      </h2>
      <p class="mt-5 text-lead text-ink-muted">{NO_TERMINATION_FEE.body}</p>

      <div class="mt-8">
        <Disclosure label="Important" pending>
          <p>{TERMINATION_QUALIFIER}</p>
        </Disclosure>
      </div>
    </div>
  </Section>

  <Cta />
</BaseLayout>
