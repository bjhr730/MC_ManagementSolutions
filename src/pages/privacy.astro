---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Disclosure from '~/components/Disclosure.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';

import {
  LEGAL_LAST_UPDATED,
  LEGAL_REVIEW_DATE,
  REVIEW_MODE,
} from '~/config/compliance';
import { CONTACT, LEGAL_ENTITY } from '~/config/site';

/*
  Antonio's privacy policy, November 2026, replacing the earlier draft.

  His text carried two placeholders and neither is printed at the reader.

  "Effective Date: [Insert Date]" uses the mechanism this page already had:
  LEGAL_REVIEW_DATE is null until an attorney signs off, so the header says
  "Draft - not yet reviewed" in plain words. Setting that one constant turns
  every legal page's date on at once. A made-up date on a policy that has
  not been reviewed would be worse than no date.

  "[Insert Business Email]" is now known, so it reads from CONTACT.email
  along with the phone number and the legal entity name. If the mail domain
  changes, this page follows.
*/
---

<BaseLayout
  title="Privacy Policy"
  description="What information MC Management Solutions collects through this website, how it is used, how long it is kept, and how to ask for a copy or its deletion."
>
  <PageHeader
    eyebrow="Legal"
    title="Privacy Policy"
    lead={LEGAL_REVIEW_DATE
      ? `Effective date: ${LEGAL_REVIEW_DATE}`
      : LEGAL_LAST_UPDATED}
  />

  <Section>
    <div class="prose-site">
      {
        REVIEW_MODE && (
          <Disclosure label="Draft" pending>
            <p>
              This policy has not been reviewed by an attorney and is not
              legal advice. Have a qualified Virginia professional review it,
              confirm whether any state privacy obligations apply, and set an
              effective date before launch.
            </p>
          </Disclosure>
        )
      }

      <p>
        At {LEGAL_ENTITY}, we respect your privacy and are committed to
        protecting the personal information you share with us.
      </p>

      <h2>Information We Collect</h2>
      <p>
        When you contact us through our website, we may collect your name,
        email address, phone number, property information, and any additional
        details you voluntarily provide.
      </p>
      <p>
        We may also collect limited technical information necessary for
        website security and functionality.
      </p>

      <h2>How We Use Your Information</h2>
      <p>
        We use the information you provide to respond to inquiries, discuss
        our services, communicate with prospective and existing clients, and
        maintain appropriate business records.
      </p>
      <p>We do not sell your personal information.</p>

      <h2>Information Sharing</h2>
      <p>
        We may use trusted third-party service providers to operate our
        website and process inquiries. We may also disclose information when
        required by law or as necessary to protect our legal rights.
      </p>

      <h2>Data Security</h2>
      <p>
        We take reasonable measures to safeguard personal information.
        However, no electronic transmission or storage system is completely
        secure.
      </p>
      <p>
        Please avoid submitting sensitive financial information, Social
        Security numbers, or other confidential documents through our general
        contact form.
      </p>

      <h2>Data Retention</h2>
      <p>
        We retain personal information only as long as reasonably necessary
        for business purposes, legal obligations, and applicable
        recordkeeping requirements.
      </p>

      <h2>Your Privacy Choices</h2>
      <p>
        You may contact us to request access to, correction of, or deletion
        of your personal information, subject to applicable legal and
        recordkeeping requirements.
      </p>

      <h2>Third-Party Services</h2>
      <p>
        Our website may contain links to third-party platforms, including our
        property management portal. These services operate under their own
        privacy policies.
      </p>

      <h2>Updates to This Policy</h2>
      <p>
        We may update this Privacy Policy periodically. Any changes will be
        reflected on this page with an updated effective date.
      </p>

      <h2>Contact Us</h2>
      <p>
        {LEGAL_ENTITY}<br />
        Phone: <a href={CONTACT.phoneHref}>{CONTACT.phone}</a><br />
        Email: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </p>
    </div>
  </Section>
</BaseLayout>
