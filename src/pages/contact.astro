---
// Rendered on demand so the page can handle its own POST and re-render with
// the submitted values and per-field errors intact, with no JavaScript.
export const prerender = false;

import BaseLayout from '~/layouts/BaseLayout.astro';
import Disclosure from '~/components/Disclosure.astro';
import InquiryForm from '~/components/InquiryForm.astro';
import JsonLd from '~/components/JsonLd.astro';
import Section from '~/components/Section.astro';

import { handleInquiry, type InquiryResult } from '~/lib/inquiry';
import {
  ADDRESS_LINES,
  CONTACT,
  MAP_URL,
  HOURS,
  SERVICE_AREAS,
  SERVICE_AREA_HEADING,
} from '~/config/site';
import { breadcrumbs, localBusiness } from '~/lib/schema';

let result: InquiryResult | null = null;

if (Astro.request.method === 'POST') {
  result = await handleInquiry(Astro.request);
  if (result.status === 'ok') {
    // POST-redirect-GET: a refresh on the thank-you page resends nothing.
    return Astro.redirect('/thank-you', 303);
  }
}

const errors = result?.status === 'invalid' ? result.errors : {};
const values = result ? result.values : {};
const formError = result?.status === 'error' ? result.message : undefined;
---

<BaseLayout
  title="Contact Us"
  description="Request a consultation or rental evaluation for your Northern Virginia property. Tell us about the property and we will come back with a written proposal."
>
  <JsonLd slot="head" schema={localBusiness()} />
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Contact Us', path: '/contact' }])}
  />

  <div class="border-b border-line bg-surface-2">
    <div class="container-page py-12 md:py-16">
      <p class="eyebrow">Contact us</p>
      <h1 class="mt-3 max-w-3xl text-h2 md:text-display">
        Tell us about your property
      </h1>
      <p class="mt-5 max-w-2xl text-lead text-ink-muted">
        A consultation costs nothing and commits you to nothing. We will look
        at the property, talk through what you want from management, and come
        back to you in writing.
      </p>
    </div>
  </div>

  <Section>
    <div class="grid gap-14 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
      <div id="inquiry" class="scroll-mt-24">
        <h2 class="text-h2">Request a consultation or rental evaluation</h2>
        <p class="mt-4 max-w-2xl text-ink-muted">
          The more you can tell us now, the more useful our first reply will be.
        </p>

        <div class="mt-10">
          <InquiryForm errors={errors} values={values} formError={formError} />
        </div>
      </div>

      <aside class="lg:border-l lg:border-line lg:pl-12">
        <h2 class="text-h3">Reach us directly</h2>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-sm font-semibold text-ink-muted">Phone</dt>
            <dd class="mt-1">
              <a
                href={CONTACT.phoneHref}
                class="text-lead font-medium text-ink underline decoration-accent decoration-2 underline-offset-4"
                >{CONTACT.phone}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-ink-muted">Email</dt>
            <dd class="mt-1">
              <a
                href={`mailto:${CONTACT.email}`}
                class="break-words font-medium text-ink underline decoration-accent decoration-2 underline-offset-4"
                >{CONTACT.email}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-ink-muted">Office</dt>
            <dd class="mt-1">
              <address class="not-italic">
                <a
                  href={MAP_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block font-medium text-ink underline decoration-accent decoration-2 underline-offset-4"
                >
                  {ADDRESS_LINES.map((line) => (
                    <span class="block">{line} </span>
                  ))}
                  <span class="sr-only">(opens Google Maps in a new tab)</span>
                </a>
              </address>
            </dd>
          </div>
        </dl>

        <div class="mt-8 rounded-lg border border-line bg-surface-2 p-5">
          <h3 class="font-serif text-base font-semibold text-ink">
            {HOURS.heading}
          </h3>
          <ul class="mt-3 space-y-1 text-sm text-ink">
            {HOURS.lines.map((line) => <li>{line}</li>)}
          </ul>
          <p class="mt-4 text-sm font-medium text-ink">{HOURS.flexibility}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            {HOURS.appointments}
          </p>
        </div>

        <div class="mt-8">
          <Disclosure label="Your information">
            <p>
              We use what you send to respond to your inquiry and prepare a
              proposal. Submitting this form does not create a management
              agreement or any obligation on either side.
            </p>
          </Disclosure>
        </div>
      </aside>
    </div>
  </Section>

  <Section tone="muted" labelledby="areas-heading">
    <div class="max-w-3xl">
      <p class="eyebrow">Service area</p>
      <h2 id="areas-heading" class="mt-3 text-h2">{SERVICE_AREA_HEADING}</h2>
    </div>

    <dl class="reveal-group mt-12 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
      {
        SERVICE_AREAS.map((area) => (
          <div class="border-t-2 border-accent pt-4">
            <dt class="font-serif text-base font-semibold text-ink">
              {area.county}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-ink-muted">
              {area.places.length > 0 && area.places.join(', ')}
              {area.places.length > 0 && area.suffix && ', '}
              {area.suffix}
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-10 max-w-2xl text-lead text-ink-muted">
      Don&rsquo;t see your area listed?{' '}
      <a
        href="#inquiry"
        class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
        >Contact us</a
      > to discuss your property and how we may be able to assist.
    </p>
  </Section>
</BaseLayout>
<script>
  /*
   * The vacancy calculator can hand its figures over when someone asks for a
   * rental evaluation. They land in the message box, visible and editable, so
   * nothing is sent that the person has not seen. Read once, then cleared.
   */
  const KEY = 'ma:vacancy-summary';

  try {
    const summary = sessionStorage.getItem(KEY);
    const field = document.getElementById('message') as HTMLTextAreaElement | null;

    if (summary && field && !field.value.trim()) {
      field.value = summary;
      sessionStorage.removeItem(KEY);

      const note = document.createElement('p');
      note.setAttribute('role', 'status');
      note.className =
        'mb-2 rounded-md bg-surface-3 px-3 py-2 text-sm font-medium text-ink';
      note.textContent =
        'Your calculator figures have been added below. Edit or delete them before sending.';
      field.parentElement?.insertBefore(note, field);
    }
  } catch {
    // Storage blocked or unavailable; the form simply arrives empty.
  }
</script>

