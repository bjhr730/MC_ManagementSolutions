---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Disclosure from '~/components/Disclosure.astro';
import JsonLd from '~/components/JsonLd.astro';
import Section from '~/components/Section.astro';

import {
  FOUNDER_NAME,
  FOUNDER_ROLE,
  FOUNDER_SECTIONS,
} from '~/content/founder';
import { BROKERAGE_SITE, LEGAL_ENTITY } from '~/config/site';
import { REVIEW_MODE } from '~/config/compliance';
import { breadcrumbs, founderPerson } from '~/lib/schema';

// The sales cross-link only goes public once the brokerage URL and firm name
// are filled in. While the site is still in review the block is shown anyway,
// clearly marked, so the wording can be approved before it is live. Virginia
// advertising rules require the firm to be identified, and both principal
// brokers should sign off on this before REVIEW_MODE is turned off.
const brokerageReady = Boolean(BROKERAGE_SITE.href);
const showBrokerage = brokerageReady || REVIEW_MODE;
---

<BaseLayout
  title="Meet the Founder"
  description="Antonio Melendez is a Northern Virginia real estate broker, property manager and investor who has led an entire property management operation."
>
  <JsonLd slot="head" schema={founderPerson()} />
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Meet the Founder', path: '/founder' }])}
  />

  <div class="border-b border-line bg-surface-2">
    <div class="container-page py-12 md:py-16">
      <div class="grid gap-10 lg:grid-cols-[22rem_1fr] lg:gap-16">
        {/*
          Headshot slot, 4:5. The real portrait drops straight in here with no
          layout change, which is why the aspect ratio is fixed now.
        */}
        <div
          class="flex aspect-4/5 w-full max-w-sm items-center justify-center rounded-lg border border-dashed border-line-strong bg-surface-3"
        >
          <p class="px-6 text-center text-sm text-ink-muted">
            Professional headshot
            <span class="mt-1 block text-xs">
              Replace with a 4:5 portrait at 1000&times;1250 or larger
            </span>
          </p>
        </div>

        <div class="lg:self-center">
          <p class="eyebrow">Meet the founder</p>
          <h1 class="mt-3 text-display">{FOUNDER_NAME}</h1>
          <p class="mt-3 text-lead text-ink-muted">{FOUNDER_ROLE}</p>
        </div>
      </div>
    </div>
  </div>

  <Section>
    <div class="prose-site">
      {
        FOUNDER_SECTIONS.map((section) => (
          <div class="mt-12 first:mt-0">
            {section.heading && <h2 class="text-h2">{section.heading}</h2>}
            {section.paragraphs.map((paragraph) => (
              <p class="text-lead text-ink-muted">{paragraph}</p>
            ))}
            {section.quote && (
              <blockquote class="mt-8 border-l-4 border-accent pl-6">
                <p class="font-serif text-h3 text-ink italic">
                  &ldquo;{section.quote}&rdquo;
                </p>
                <footer class="mt-3 text-sm font-medium text-ink-muted">
                  {FOUNDER_NAME}
                </footer>
              </blockquote>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-14 max-w-2xl text-sm text-ink-muted">
      {FOUNDER_NAME} is the founder of {LEGAL_ENTITY}.
    </p>
  </Section>

  {
    showBrokerage && (
      <Section tone="muted" labelledby="brokerage-heading">
        <div class="max-w-2xl">
          <h2 id="brokerage-heading" class="text-h2">
            Looking to Buy or Sell a Home?
          </h2>
          <p class="mt-5 text-lead text-ink-muted">
            In addition to property management, Antonio Melendez assists
            buyers, sellers, and investors throughout Northern Virginia
            through his affiliated real estate brokerage,{' '}
            {BROKERAGE_SITE.brokerage}.
          </p>

          {brokerageReady ? (
            <a
              href={BROKERAGE_SITE.href!}
              rel="noopener"
              class="btn btn-secondary mt-8"
            >
              Explore Antonio&rsquo;s Real Estate Services
            </a>
          ) : (
            <div class="mt-8">
              <Disclosure label="Not live yet" pending>
                <p>
                  This cross-link is hidden from the public site until
                  <code>BROKERAGE_SITE</code> in <code>src/config/site.ts</code>{' '}
                  has the brokerage&rsquo;s real name and website. Virginia
                  advertising rules require the licensed firm to be identified,
                  and both principal brokers should approve this wording and
                  the cross-linking before it goes live.
                </p>
              </Disclosure>
            </div>
          )}
        </div>
      </Section>
    )
  }

  <Cta
    heading="Request an owner consultation"
    body="Your consultation is an opportunity to discuss your property, your goals, and your expectations directly with the person who will be managing it."
  />
</BaseLayout>
